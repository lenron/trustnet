/* This <style> seems to set syntax highlighting correctly. */

	* {
		font-family: "Orbitron", serif;
		font-optical-sizing: auto;
		font-weight: 600;
		font-style: normal;
		color: var(--site-type-color);
	}

	html, body {
		background-color: #272727;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		margin: 0;
		padding: 0;
	}

	.main_site {
		height: 100%;
	}

	.header {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		color: var(--site-type-color);
		padding: 4px;
		padding-right: 10px;
		padding-left: 10px;
	}

	.header_content {
		display: flex;
	}

	.header_title:hover {
		cursor: pointer;
	}

	.header_label {
		padding: 8px;
	}

	.center_html {
		width: 100%;
		min-height: 100%;
		background-color: #272727;
		flex: 1 auto;
		display: flex;
		justify-content: center;
	}

/*	 Single (pages) shown to user as they (flow) through site. */
	.flow_pages {
		width: 700px;
		margin: 10px;
		align-self: center;
		display: flex;
		flex-direction: column;
		justify-content: center; 
		color: var(--site-type-color);
	}

	/* default button styling. HTML style="" will override. */
	button {
		/*width: 400px;*/
		height: 65px;
		background-color: #434343;
		border: 2px solid;
		padding: 2px;
		margin: 8px;
		padding-right: 10px;
		padding-left: 10px;
		color: var(--site-type-color);
		border-color: var(--site-type-color);
		font-size: 17px;
		border-radius: 15px;
	}

	/*input[type="password"] {*/
	.main_site_password_input {
		height: 80px;
		width: 95%;
		background-color: #272727;
		border: 2px solid;
		padding: 8px;
		margin: 8px;
		border-color: var(--site-type-color);
		color: var(--site-type-color);
		font-size: 25px;
		border-radius: 20px;
	}

	a {
		font-family: Arial, Helvetica, sans-serif;
		font-size: 16px;
		color: #4491d5;
	}

	p {
		font-family: Arial, Helvetica, sans-serif;
		font-size: 16px;
		color: black;
	}

	/* Change the textareas inside divs with 'flow_pages' class to the following: */
	.flow_pages textarea {
		width: 95%;
		height: 150px;
		background-color: #272727;
		border: 2px solid;
		padding: 12px;
		margin: 8px;
		border-color: var(--site-type-color);
		color: var(--site-type-color);
		font-size: 25px;
		border-radius: 30px;
	}

	/* 'Are you sure?' overlay */
	.deletecheck {
		justify-content:center;
		align-items:center;
		z-index:10;
		position:absolute;
		width:100%;
		height:215%;
		background-color:gray;
		padding:8px;
		margin-left:0;
		margin-top:-40%;
		flex-direction: column;
		border:2px solid;
		border-color:red; 
		border-radius:30px;
	}

	.devsite_inputs {
		font-family: Arial, Helvetica, sans-serif;
		font-size: 16px;
		color: black;
		background-color: grey;
	}

	.tooltip {
		font-family: Arial, Helvetica, sans-serif;
		font-size: 16px;
		color: black;
	}

	/* Add this class to a span or label (and other types?) to make it a cool looking pink */
	.coolpink {
		color:magenta;
		text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;
	}

	/* Change cursor image to pointer with plus (identified by 'copy' indicator) */
	/* Apply hover to div child elements recursively which apply encrypt_hover class.*/
	.encrypt_hover:hover * {
		cursor: copy;
	}
	/* Apply hover to specific div id*/
	#encrypt_click_access:hover {
		cursor: copy;
	}
	/* Apply hover to specific div */
	#encrypt_click_store:hover {
		cursor: copy;
	}

	/* Apply hover to div child elements recursively which apply encrypt_hover class.*/
	.decrypt_hover:hover * {
		cursor: copy;
	}
	/* Apply hover to specific div */
	#decrypt_click_access:hover {
		cursor: copy;
	}
	/* Apply hover to specific div */
	#decrypt_click_store:hover {
		cursor: copy;
	}

	.openssl_encrypt_flowchart {
		background-image: url('./svg_images/openssl_encrypt_flowchart.drawio.svg');
	}

	.openssl_decrypt_flowchart {
		background-image: url('./svg_images/openssl_decrypt_flowchart.drawio.svg');
	}

	/* Makes the background color blend from orange to #AEE850 */
	.glossy_button {
		background: linear-gradient(orange, #aee850);
		border: 1px solid #1d6511;
		color: black;
		font-size: 12px;
		height: 30px;
		cursor: pointer;
	}

	/* Dev site Responsive Design */
	/* --> below width size that changes from desktop to mobile or tablet, */
	/* width 90% or whatever makes sense */
/*
	@media screen and (max-width:500px) {
		/* Narrow all textareas on mobile screens.
		textarea {
			width: 140px;
		}
	}
*/

	/* Makes the text blend from orange to #AEE850 */
	/* background-clip: text creates a 'cut-out' of the background where the text exists, creating text with a linear gradient.
	.glossy_icon {
		background-image: linear-gradient(orange, #aee850);
		color: transparent;
		background-clip: text;
	}
*/

	/* Set minimum page Width to */
	@media screen and (max-width: 340px) { html,body {min-width: 340px} }

	/* Set minimum page Height to 400 */
	@media screen and (max-height: 400px) { html,body {min-height: 400px} }	

	/* Responsive Design: When the viewport is fewer than 700px wide, activate the following CSS. */
	@media screen and (max-width:700px) {

		input[type="password"] {
			width: 90%;
		}

		textarea {
			width: 90%;
		}

		.header {
			flex-direction: column;
		}

		.home button {
			width: 200px;
			/*border-color: black;*/
		}

		.home_buttons {
			/*flex-direction: column;*/
		}

		.choose button {
			font-size: 14px;
		}

		.upload input {
			font-size: 16px;
		}

		.deletecheck {
			margin-top: -50%;
			height: 220%;
		}
	}

	@media screen and (max-width:500px) {
		.home button {
			width: 150px;
			font-size: 14px;
			/*border-color: black;*/
		}

		.deletecheck {
			width: 95%;
			margin-top: -75%;
			height:250%;
		}
	}


	/*    FAQ Site   */
	.faq_site {
		width: 100%;
		min-height: 100%;
		background-color: #272727;
		flex: 1 auto;
		display: none;
		justify-content: center;
	}


	/*    Dev Site   */
	.main_page {
		background-color: #272727;
		display: flex;
		flex-direction: column;
		min-height: 90vh;
		margin: 0;
		padding: 0;
	}

	.dev_site {
		background-color: #272727;
		display: none;
		flex-direction: column;
		min-height: 90vh;
		margin: 0;
		padding: 0;
	}

	.glossy_icon {
		color: magenta;
	}

	.sidebar_button {
		margin-top: 20px;
		writing-mode: vertical-lr;
		/* Scale appears to rotate text around a center point. Translate then moves it to the right enough to not be cut off by the left screen edge. */
		transform: scale(-1, -1) translate(-15px);
		cursor: pointer;
	}

	.dev_site_sections {
		display:flex;
		flex-direction:column;
		padding:10px;
		margin-bottom:10px;
		width: 90%;
	}

	.textarea_div_heightcontrol {
		height: 400px;
	}

	textarea {
		background-color: #272727;
		border: 2px solid;
		border-color: #54c597;
		color: #54c597;
		border-radius: 10px;
		/* Use the first font installed on your system. */
		font-family: Consolas,Monaco,Lucida Console,Liberation Mono,DejaVu Sans Mono,Bitstream Vera Sans Mono,Courier New;
		/*font-family: Liberation Mono;*/
		height: 100%;
	}

	.dev_site_password_input {
		padding: 6px;
		background-color: #272727;
		border: 2px solid;
		border-color: #54c597;
		color: #54c597;
		border-radius: 10px;
		/* Use the first font installed on your system. */
		font-family: Consolas,Monaco,Lucida Console,Liberation Mono,DejaVu Sans Mono,Bitstream Vera Sans Mono,Courier New;
	}


