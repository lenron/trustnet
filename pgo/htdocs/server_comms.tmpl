		//Can be triggered by: a DNS failure, connection timeout, or the user being offline.
		// 500 Internal Server Errors will be caught here too.
		}catch(error) { // Catch rejected promise.
			console.error(error.message);
		}
	}// serverDelete()

	// Attempts to delete active passlock from online database. After ~5 minutes the database will delete the passlock itself for added security.
	// Runs after Store or Access call completes as a security measure to ensure user passlocks exist only as long as necessary.
	async function serverDeletePasslock(passedBrowserId) {
		let SERVER_URL = getOnlineServerOrigin();
		SERVER_URL += 'exepasslockdelete';

		try { // Catch a rejected promise so we can operate on it.
			// Execute HTTP request to SERVER_URL with the following options.
			const fetchResponseObject = await fetch(SERVER_URL, {
				method: 'POST',
				headers: {
					'Content-Type': 'text/plain',
				},
				body: JSON.stringify({ // Convert javascript JSON object into string for transport.
					// browser_id is the key which will be used to access data on server side.
					browser_id: passedBrowserId,
				}),
			});

			if (!fetchResponseObject.ok) { // Indicates HTTP error.
				// Response Status is the numerical code like 404, 500, etc.
				throw new Error(fetchResponseObject.status);
			}
			// Now that we've cleared the error check, we can proceed with processing the response.
			const responseObj = await fetchResponseObject.json();
			console.log("delete passlock response: ");
			console.log(responseObj);
			// Handle database query outcome.
			if (responseObj.response !== "passlock successfully deleted") { // there appears to be a problem.
				throw Error("serverDeletePasslock() Failed to delete passlock!");
				return "error";
			}else{
				console.log("Passlock successfully deleted from database.");
				return "success";
			}
		//Can be triggered by: a DNS failure, connection timeout, or the user being offline.
		} catch (error) { // Catch rejected promise.
			console.error(error.message);
		}
	}// serverDeletePasslock()

	// Ask the server to extend time period before it auto-deletes a passlock.
