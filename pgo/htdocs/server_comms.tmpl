		}
	}// serverExtendPasslock()

	// When a user begins a UI Flow, begin 5 minute passlock timer by sending browserId, passlock to server to store as key-value pair.
	// This function creates the record on server which will be auto-deleted from by the server after 5 minutes.
	// If a passlock corresponding to a browserId isn't found on server, user will not be allowed to continue along UI Flow.
	async function serverSetPasslock(browserId, passlock) {
		let SERVER_URL = getOnlineServerOrigin();
		SERVER_URL += 'exesetpasslock';

		try { // Catch a rejected promise so we can operate on it.
			// Execute HTTP request to SERVER_URL with the following options.
			const fetchResponseObject = await fetch(SERVER_URL, {
				method: 'POST',
				headers: {
					'Content-Type': 'text/plain',
				},
				body: JSON.stringify({ // Convert javascript JSON object into string for transport.
					// browser_id is the key which will be used to access passlock server side.
					browser_id: browserId,
					passlock: passlock,
				}),
			});

			if (!fetchResponseObject.ok) { // Indicates HTTP error.
				// Response Status is the numerical code like 404, 500, etc.
				throw new Error(fetchResponseObject.status);
			}
			// Now that we've cleared the error check, we can proceed with processing the response.
			const response_obj = await fetchResponseObject.json();
			if (response_obj.response != 1) { // there appears to be a problem.
				throw Error("serverSetPasslock() database store error!");
			}else{
				return;
			}
		//Can be triggered by: a DNS failure, connection timeout, or the user being offline.
		} catch (error) { // Catch rejected promise.
			console.error(error.message);
		}
	}// serverSetPasslock()

	// Access passlock from server as user moves through UI.
	// If a passlock corresponding to a browserId isn't found on server, user will not be allowed to continue along UI Flow.
	// Passlock will then be used to either encrypt user plaintext data or decrypt when ready to execute a Store or Access.
	async function serverGetPasslock(browserId) {
		let SERVER_URL = getOnlineServerOrigin();
		SERVER_URL += 'exegetpasslock';

		try { // Catch a rejected promise so we can operate on it.
			// Execute HTTP request to SERVER_URL with the following options.
			const fetchResponseObject = await fetch(SERVER_URL, {
				method: 'POST',
				headers: {
					'Content-Type': 'text/plain',
				},
				body: JSON.stringify({ // Convert javascript JSON object into string for transport.
					// browser_id is the key which will be used to access passlock server side.
					browser_id: browserId,
				}),
			});

			if (!fetchResponseObject.ok) { // Indicates HTTP error.
				// Response Status is the numerical code like 404, 500, etc.
				throw new Error(fetchResponseObject.status);
			}
			// Now that we've cleared the error check, we can proceed with processing the response.
			const responseObj = await fetchResponseObject.json();
			if (responseObj.passlock.length === PASSLOCK_LENGTH && checkUUIDChars(responseObj.passlock)) { // Data looks good.
				return responseObj.passlock;
			}else{
				throw Error("serverGetPasslock: Failed to load passlock.");
				return "failed to get passlock";
			}
		//Can be triggered by: a DNS failure, connection timeout, or the user being offline.
		} catch (error) { // Catch rejected promise.
			console.error(error.message);
		}
	}// serverGetPasslock()




