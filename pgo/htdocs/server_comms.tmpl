			// Now that we've cleared the error check, we can proceed with processing the response.
			const response_obj = await fetchResponseObject.json();
			if (response_obj.response != 1) { // There appears to be a problem.
				throw Error("serverExtendPasslock() database store error!");
			}else{
				console.log("Passlock successfully extended.");
