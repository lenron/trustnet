	// Replaces the randomly generated 'dummy' chars with 43 length fingerprint and 1024 length encrypted data.
	// Used for store when fingerprint does not exist. Pointer needed for this function. 
	function storeFingerprintAndDataToOfflineDBase(pointer, fingerprint, multiEncryptedDatarecord, offlineDatabase) {
		// Multiplying moves us to record at pointer.
		const recordStart = pointer * FINGERPRINT_AND_MEDRECORD_LENGTH_BASE64;
		const recordEnd = recordStart + FINGERPRINT_AND_MEDRECORD_LENGTH_BASE64;
		// Compile replacement database. 
		// <Data in database until recordStart> + <fingerprint data> + <MED data> + <Data in database until recordEnd>
		return offlineDatabase.substring(0, recordStart) + fingerprint + multiEncryptedDatarecord + offlineDatabase.substring(recordEnd);
	}

	// Used for delete, RandDAta is needed to backfill keeping offlineDatabase the same length.
	// Used for store when fingerprint exists.
	function replaceFingerprintAndData(fingerprint, offlineDatabase, newData='delete') {
		const fingerprintStartIndex = offlineDatabase.indexOf(fingerprint);
		// Use a random fingerprint and data if neither were specified.
		if (newData === 'delete') {
			fingerprint = getRandFingerprint();
			newData = getRandMultiEncryptedDatarecord();
		}
		const recordEnd = fingerprintStartIndex + FINGERPRINT_AND_MEDRECORD_LENGTH_BASE64;
		return offlineDatabase.substring(0, fingerprintStartIndex) + fingerprint + newData + offlineDatabase.substring(recordEnd);
	}

	// Selects either Unencrypted or Encrypted database pointer based on if user inputted an offline database password at the start of the Flow.
	async function getOfflineDBasePointer() {
		// To determine which database pointer to return, first check if user entered an Offline Database password.
		if (getOfflineDatabaseType() === 'unencrypted') {
			return document.getElementById("offline_dbase_pointer").innerHTML;
		}else{
			const encPointer = document.getElementById("offline_dbase_enc_pointer").innerHTML;
			return await decryptTriple(offlineData['offlineDBasePass'], offlineData['offlineDBasePass'], offlineData['offlineDBasePass'], encPointer);
		}
	}

	// Returns either Unencrypted or Encrypted full offline database depending if user entered an offline database password.
	async function getOfflineDBase() {
		// To determine which database pointer to return, first check if user entered an Offline Database password.
		if (getOfflineDatabaseType() === 'unencrypted') {
			// User didn't enter password, return unencrypted as-is.
			return document.getElementById("offline_dbase").innerHTML;
		}else{
			// We need to decrypt the encrypted offline database which is stored in the html element.
			const encOfflineDatabase = document.getElementById("offline_dbase_enc").innerHTML;
			return await decryptAESCTR(encOfflineDatabase, offlineData['offlineDBasePass']);
		}
	}

