	function checkIfOfflineDBaseIsFull(pointer) {
		// Check if offline database is full.
		if (pointer > MAX_POINTER_VALUE) {//999 is ok because we should still be able to store to the last location in the 1000 record databaase. 
			// Inform user offline database is full.
			document.getElementById("full_offline_dbase_warning").style.display = "inline";
			return true;
		}else{
			document.getElementById("full_offline_dbase_warning").style.display = "none";
			return false;
		}
	}

	function fingerprintExists(fingerprint, offlineDatabase) {
		// -1 will indicate that the fingerprint was not found.
		if (offlineDatabase.indexOf(fingerprint) >= 0) {
			return true;
		}else{
			return false;
		}
	}

	// Store single record to the offline database selected by if user enters offline database password or not.
	async function storeOfflineDBase(fingerprint, multiEncryptedDatarecord) {
		// Reject invalid data.
		checkFingerprintAndData(fingerprint, multiEncryptedDatarecord);
		// Retrieve the database and pointer for the Flow we are in.
		let pointer = await getOfflineDBasePointer();
		//console.log("pointer value: " + pointer);
		let offlineDatabase = await getOfflineDBase();
		//Check if the offline database is full.
		if (checkIfOfflineDBaseIsFull(pointer)) {
			return "full";
		}
		// Variable to hold the new database.
		let replacement_offlineDatabase;
		//Check if the fingerprint matches the database and replace the data.
		if (fingerprintExists(fingerprint, offlineDatabase)) {
			replacement_offlineDatabase = replaceFingerprintAndData(fingerprint, offlineDatabase, multiEncryptedDatarecord);
		}else{ // If the fingerprint was not found, store a new value in the database.
			replacement_offlineDatabase = storeFingerprintAndDataToOfflineDBase(pointer, fingerprint, multiEncryptedDatarecord, offlineDatabase);
			pointer++;
			checkIfOfflineDBaseIsFull(pointer);
		}
		// Save pointer and offline database to in-memory HTML. ENC or UNENC determined by if an offline database ENC password was entered at flow start.
		await setOfflineDBasePointer(pointer);
		await setOfflineDBase(replacement_offlineDatabase);
	}

	// Try to load record at fingerprint. Works on both ENC and UNENC offline databases.
	async function attemptLoadOfflineDBase(fingerprint) {
		//console.log("Attempting Load. fingerprint: " + fingerprint);
		let offlineDatabase = await getOfflineDBase();
		// Search for fingerprint in offline dbase using regex.
		// fingerprintStartIndex will be the index of the beginning of the matched fingerprint.
		if (fingerprintExists(fingerprint, offlineDatabase)) {
			return getRecordOfflineDBase(fingerprint, offlineDatabase);
		}else{
			// Did  not find data on load attempt.
			return "miss";
		}
	}//attemptLoadOfflineDBase(()

	// Retrieve one 1000-char data record from an offline database. 
	function getRecordOfflineDBase(fingerprint, offlineDatabase) {
		const fingerprintStartIndex = offlineDatabase.indexOf(fingerprint);
		const fingerprintEndIndex = fingerprintStartIndex + FINGERPRINT_LENGTH_BASE64;
		const dataEndIndex = fingerprintEndIndex + MULTI_ENCRYPTED_DATARECORD_LENGTH_BASE64;
		// Get the data between fingerprintEndIndex and dataEndIndex.
		return offlineDatabase.substring(fingerprintEndIndex, dataEndIndex);
	}

	function checkFingerprint(fingerprint) {
		if (!checkFingerprintIsValid(fingerprint)) {
			throw new Error('Attempt to DELETE single record in offline dbase failed! FINGERPRINT is invalid.');
		}else{
			console.log("Delete Offline Database record attempt: FINGERPRINT IS VALID!");
		}
	}

	// Random data is generated and 'backfilled' increasing security and keeping Offline Database length the same.
	async function deleteRecordOfflineDBase(fingerprint) {
		checkFingerprint(fingerprint);
		// Select either ENC or UNENC pointer, offline database depending on if user entered ENC passowrd.
		let offlineDatabase = await getOfflineDBase();
		// Find record in offline dbase if it exists.
		// If the record exists, delete the fingerprint and data at fingerprintStartIndex location by overwriting with randonly generated, decrementing pointer.
		if (fingerprintExists(fingerprint, offlineDatabase)) {
			// Calling with empty third parameter indicates to replace with random data (deleting the record).
			const replacement_offlineDatabase = replaceFingerprintAndData(fingerprint, offlineDatabase);

			await setOfflineDBase(replacement_offlineDatabase);
			// Check that it was in fact deleted. Fingerprint should be random chars now and therefore miss on a correctly exexuted delete.
			const outcome = await attemptLoadOfflineDBase(fingerprint);
			if (outcome === "miss") {
				//console.log("Delete successful: returned miss from load attempt.");
				return "success";
			}else{
				console.log("Failed to delete data from offline database.");
				return "failed";
			}
		}else{
			console.log("Failed to find fingerprint, data to delete.");
			return "failed";
		}
	}//deleteRecordOfflineDBase()


