<!DOCTYPE HTML>
<html>
<meta content="text/plain;charset=utf-8" http-equiv="Content-Type" />
<meta content="utf-8" http-equiv="encoding" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<head>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&display=swap" rel="stylesheet">
</head>
<style>

	* {
		font-family: "Orbitron", serif;
		font-optical-sizing: auto;
		font-weight: 600;
		font-style: normal;
		color: #<TMPL_VAR NAME=page_type_color>;
	}

	html, body {
		background-color: #272727;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		margin: 0;
		padding: 0;
	}

	.main_page {
		background-color: #272727;
		display: flex;
		flex-direction: column;
		min-height: 90vh;
		margin: 0;
		padding: 0;
	}

	.dev_site {
		background-color: #272727;
		display: none;
		flex-direction: column;
		min-height: 90vh;
		margin: 0;
		padding: 0;
	}

	.main_site {
		height: 100%;
	}

	.header {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		color: #<TMPL_VAR NAME=page_type_color>;
		padding: 4px;
		padding-right: 10px;
		padding-left: 10px;
	}

	.header_content {
		display: flex;
	}

	.header_title:hover {
		cursor: pointer;
	}

	.header_label {
		padding: 8px;
	}

	.center_html {
		width: 100%;
		min-height: 100%;
		background-color: #272727;
		flex: 1 auto;
		display: flex;
		justify-content: center;
	}

	/* Single (pages) shown to user as they (flow) through site. */
	.flow_pages {
		width: 700px;
		margin: 10px;
		align-self: center;
		display: flex;
		flex-direction: column;
		justify-content: center; 
		color: #<TMPL_VAR NAME=page_type_color>;
	}

	/* default button styling. HTML style="" will override. */
	button {
		/*width: 400px;*/
		height: 65px;
		background-color: #434343;
		border: 2px solid;
		padding: 2px;
		margin: 8px;
		padding-right: 10px;
		padding-left: 10px;
		color: #<TMPL_VAR NAME=page_type_color>;
		border-color: #<TMPL_VAR NAME=page_type_color>;
		font-size: 17px;
		border-radius: 15px;
	}

	/*input[type="password"] {*/
	.main_site_password_input {
		height: 80px;
		width: 95%;
		background-color: #272727;
		border: 2px solid;
		padding: 8px;
		margin: 8px;
		border-color: #<TMPL_VAR NAME=page_type_color>;
		color: #<TMPL_VAR NAME=page_type_color>;
		font-size: 25px;
		border-radius: 20px;
	}

	a {
		font-family: Arial, Helvetica, sans-serif;
		font-size: 16px;
		color: #4491d5;
	}

	p {
		font-family: Arial, Helvetica, sans-serif;
		font-size: 16px;
		color: black;
	}

	/* Change the textareas inside divs with 'flow_pages' class to the following: */
	.flow_pages textarea {
		width: 95%;
		height: 150px;
		background-color: #272727;
		border: 2px solid;
		padding: 12px;
		margin: 8px;
		border-color: #<TMPL_VAR NAME=page_type_color>;
		color: #<TMPL_VAR NAME=page_type_color>;
		font-size: 25px;
		border-radius: 30px;
	}

	/* 'Are you sure?' overlay */
	.deletecheck {
		justify-content:center;
		align-items:center;
		z-index:10;
		position:absolute;
		width:100%;
		height:215%;
		background-color:gray;
		padding:8px;
		margin-left:0;
		margin-top:-40%;
		flex-direction: column;
		border:2px solid;
		border-color:red; 
		border-radius:30px;
	}

	.devsite_inputs {
		font-family: Arial, Helvetica, sans-serif;
		font-size: 16px;
		color: black;
		background-color: grey;
	}

	.tooltip {
		font-family: Arial, Helvetica, sans-serif;
		font-size: 16px;
		color: black;
	}

	/* Add this class to a span or label (and other types?) to make it a cool looking pink */
	.coolpink {
		color:magenta;
		text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;
	}

	.glossy_icon {
		color: magenta;
	}

	/* Change cursor image to pointer with plus (identified by 'copy' indicator) */
	/* Apply hover to div child elements recursively which apply encrypt_hover class.*/
	.encrypt_hover:hover * {
		cursor: copy;
	}
	/* Apply hover to specific div id*/
	#encrypt_click_access:hover {
		cursor: copy;
	}
	/* Apply hover to specific div */
	#encrypt_click_store:hover {
		cursor: copy;
	}

	/* Apply hover to div child elements recursively which apply encrypt_hover class.*/
	.decrypt_hover:hover * {
		cursor: copy;
	}
	/* Apply hover to specific div */
	#decrypt_click_access:hover {
		cursor: copy;
	}
	/* Apply hover to specific div */
	#decrypt_click_store:hover {
		cursor: copy;
	}

	.openssl_encrypt_flowchart {
		background-image: url('./svg_images/openssl_encrypt_flowchart.drawio.svg');
	}

	.openssl_decrypt_flowchart {
		background-image: url('./svg_images/openssl_decrypt_flowchart.drawio.svg');
	}

	/* Makes the background color blend from orange to #AEE850 */
	.glossy_button {
		background: linear-gradient(orange, #aee850);
		border: 1px solid #1d6511;
		color: black;
		font-size: 12px;
		height: 30px;
		cursor: pointer;
	}

	.sidebar_button {
		margin-top: 20px;
		writing-mode: vertical-lr;
		/* Scale appears to rotate text around a center point. Translate then moves it to the right enough to not be cut off by the left screen edge. */
		transform: scale(-1, -1) translate(-15px);
		cursor: pointer;
	}

	.dev_site_sections {
		display:flex;
		flex-direction:column;
		padding:10px;
		margin-bottom:10px;
		width: 90%;
	}

	.textarea_div_heightcontrol {
		height: 400px;
	}


	/* Dev site Responsive Design */
	/* --> below width size that changes from desktop to mobile or tablet, */
	/* width 90% or whatever makes sense */
/*
	@media screen and (max-width:500px) {
		/* Narrow all textareas on mobile screens.
		textarea {
			width: 140px;
		}
	}
*/

	/* Makes the text blend from orange to #AEE850 */
	/* background-clip: text creates a 'cut-out' of the background where the text exists, creating text with a linear gradient.
	.glossy_icon {
		background-image: linear-gradient(orange, #aee850);
		color: transparent;
		background-clip: text;
	}
*/

	/* Set minimum page Width to */
	@media screen and (max-width: 340px) { html,body {min-width: 340px} }

	/* Set minimum page Height to 400 */
	@media screen and (max-height: 400px) { html,body {min-height: 400px} }	

	/* Responsive Design: When the viewport is fewer than 700px wide, activate the following CSS. */
	@media screen and (max-width:700px) {

		input[type="password"] {
			width: 90%;
		}

		textarea {
			width: 90%;
		}

		.header {
			flex-direction: column;
		}

		.home button {
			width: 200px;
			/*border-color: black;*/
		}

		.home_buttons {
			/*flex-direction: column;*/
		}

		.choose button {
			font-size: 14px;
		}

		.upload input {
			font-size: 16px;
		}

		.deletecheck {
			margin-top: -50%;
			height: 220%;
		}
	}

	@media screen and (max-width:500px) {
		.home button {
			width: 150px;
			font-size: 14px;
			/*border-color: black;*/
		}

		.deletecheck {
			width: 95%;
			margin-top: -75%;
			height:250%;
		}
	}


	textarea {
		background-color: #272727;
		border: 2px solid;
		border-color: #54c597;
		color: #54c597;
		border-radius: 10px;
		/* Use the first font installed on your system. */
		font-family: Consolas,Monaco,Lucida Console,Liberation Mono,DejaVu Sans Mono,Bitstream Vera Sans Mono,Courier New;
		/*font-family: Liberation Mono;*/
		height: 100%;
	}

	.dev_site_password_input {
		padding: 6px;
		background-color: #272727;
		border: 2px solid;
		border-color: #54c597;
		color: #54c597;
		border-radius: 10px;
		/* Use the first font installed on your system. */
		font-family: Consolas,Monaco,Lucida Console,Liberation Mono,DejaVu Sans Mono,Bitstream Vera Sans Mono,Courier New;
	}


</style>
<body>
	<!--------------------------HEADER----------------------------!>
	<div class="header" id="header">
		<div class="header_content" id="header_left">
			<div class="header_title">
				<a href="https://<TMPL_VAR NAME=origin>" id="titletext" style="font-size:30px; text-decoration:underline;" ><TMPL_VAR NAME=titletext></a>
			</div>
		</div>
		<div class="header_content" id="header_right">
			<div class="header_label" style="">
				<a href="https://obf.mkrsvr.org/faq">FAQ</a>
			</div>
			<div class="header_label" style="">
				<a href="javascript:void(0);" onclick="toggleDevSite()">DEV_SITE</a>
			</div>
			<div class="header_label" style="">
				<a href="https://obf.mkrsvr.org/contact">CONTACT</a>
			</div>
		</div>
	</div>
	
	<!--------------------------DEV SITE--------------------------------------------------------------------------------------------------------------------------------------------------------!>
	<div class="dev_site" id="dev_site">
		<!--------------------------Sidebar and Page----------------------------!>
		<div class="" id="sidebar_and_page" style="display:flex; flex-direction:row; width:100%; ">
			<!--------------------------SIDEBAR----------------------------!>
			<div class="" id="sidebar_section" style="position:fixed; display:flex; flex-direction:column; align-items:flex-end; background-color:#434343; margin-top:50px; width:20px; height:100%; ">
				<div class="sidebar_button" id="openssl_sidebar_button" style="">
					<a id="" href="#openssl" style="text-decoration:none; "><p id="openssl_sidebar_text" style="color:magenta; ">AES-CBC</p></a>
				</div>
				<div class="sidebar_button" id="gcm1000_sidebar_button" style="">
					<a id="" href="#gcm1000" style="text-decoration:none; "><p id="gcm1000_sidebar_text" style=" ">OBF-1000</p></a>
				</div>
				<div class="sidebar_button" id="aesctr_sidebar_button" style="">
					<a id="" href="#aesctr" style="text-decoration:none; "><p id="aesctr_sidebar_text" style=" ">AES-CTR</p></a>
				</div>
				<div class="sidebar_button" id="triple_sidebar_button" style="">
					<a id="" href="#triple" style="text-decoration:none; "><p id="triple_sidebar_text" style=" ">Triple Cipher</p></a>
				</div>
			</div>
			<!--------------------------SIDEBAR----------------------------!>
			<!--------------------------Header and Functions----------------------------!>
			<div class="" id="header_and_functions" style="display:flex; flex-direction:column; margin-left:5px; width:100%; ">
				<!--------------------------FUNCTIONS----------------------------!>
				<div class="" id="functions_section" style="display:flex; flex-direction:column; align-items:center; width:90%; margin-top:50px; ">
					<!--------------------------OpenSSL SECTION-------------------------------------!>
					<div class="dev_site_sections" id="openssl_section" style=" padding-bottom:30px; ">
						<div style="position:relative; ">
							<div class="" id="openssl_tooltip" style="display:flex; position:absolute; z-index:2; top:50px; left:50px; display:none; background-color:#434343; border:5px solid gold; padding:5px;">
								<p>
									OpenSSL was chosen for the base encryption because it is widely available from the command line and its featureset includes AES-256-CBC symmetric encryption/decryption which is good enough for the US government as described in its spec document,
									<a href="https://datatracker.ietf.org/doc/html/rfc3602" target="_blank">RFC3602.</a>
									<br>
									<br>
									<span style="color:magenta; ">No data is ever sent to any server!</span> All OBF functionality including OpenSSL, OBF-1000, AES-CTR is executed on the client side in the browser. You can check this yourself by turning internet off while keeping the browser up or by checking using the browser's developer tools (ctrl+shift+i in chrome based) and clicking on Network tab which shows all packets sent and received by the browser.

									Our OpenSSL implementation uses the MDN SubtleCrypto library with the encrypt() function which has many options for use including AES-256-CBC.
									<br>

									<div style='display:flex; flex-direction:column; width:fit-content; padding:5px;'>
										<label>Linux Command Line Commands:</label>
										<div class="encrypt_hover" id="encrypt_click_access" style="display:flex; flex-direction:column; border-style:solid; border-color:cyan; padding:10px; margin-bottom:5px; ">
											<div style="display:flex; justify-content:space-between;">
												<label>Encrypt:</label>
												<span class="copied_encrypt_command_inform_class" id="" style="color:red; display:none;">ENCRYPT COMMAND COPIED!</span>
											</div>
											<label>openssl enc -aes-256-cbc <span class="coolpink" style="">-e</span> -pbkdf2 -in <span class="coolpink">yourfile.txt</span> -out <span class="coolpink">yourfile.enc</span></label>
										</div>
										<div class="decrypt_hover" id="decrypt_click_access" style="display:flex; flex-direction:column; border-style:solid; border-color:yellow; padding:10px; ">
											<div style="display:flex; justify-content:space-between;">
												<label>Decrypt:</label>
												<span class="copied_decrypt_command_inform_class" id="" style="color:red; display:none;">DECRYPT COMMAND COPIED!</span>
											</div>
											<label>openssl enc -aes-256-cbc <span class="coolpink" style="">-d</span> -pbkdf2 -in <span class="coolpink">yourfile.enc</span> -out <span class="coolpink">yourfile.txt</span></label>
										</div>
									</div>

									Specification Documentation:
									<br>
									<a href="https://developer.mozilla.org/en-US/docs/Web/API/SubtleCrypto/encrypt" target="_blank">encrypt() MDN Documentation</a><br>
									<a href="https://www.w3.org/TR/webcrypto/#aes-cbc" target="_blank">AES-CBC W3C Specification/Documentation</a><br>
									<a href="https://www.w3.org/TR/webcrypto/#aes-ctr" target="_blank">AES-CTR W3C Specification/Documentation</a><br>
									<a href="https://www.w3.org/TR/webcrypto/#SubtleCrypto-method-importKey" target="_blank">importKey() W3C Specification/Documentation</a><br>
									<a href="https://developer.mozilla.org/en-US/docs/Web/API/SubtleCrypto" target="_blank">SubtleCrypto Documentation</a><br>
									<a href="https://en.wikipedia.org/wiki/World_Wide_Web_Consortium" target="_blank">W3C Wiki</a><br>

								</p>
								<button class="glossy_button" onclick="hideTipOpenSSL()">Close</button>
							</div>
						</div>
						<div style="display:flex;  ">
							<h3 id="openssl" style="scroll-margin-top:75px; ">OpenSSL AES-256-CBC</h3>
							<a class="glossy_icon" style="margin-top:13px; " href="javascript:void('show tooltip')" onclick="showTipOpenSSL()" >[?]</a>
						</div>
						<div class="textarea_div_heightcontrol" id="" style="display:flex; flex-direction:row; ">
							<div id="" style="display:flex; flex-direction:column; flex-grow:5; ">
								<div id="" style="display:flex; flex-direction:row; justify-content:space-between; ">
									<label id="openssl_cleartext_label" style="align-self:flex-end;">Cleartext:</label>
									<div id="" style="display:flex; flex-direction:column; justify-content:flex-end; ">
										<label id="openssl_cleartext_bytesize_label" style="color:gray; ">Bytes:</label>
									</div>
								</div>
								<textarea value="" id="openssl_cleartext" style="" oninput="executeOpenSSL()"></textarea>
							</div>
							<div id="" style="display:flex; flex-direction:column; flex-grow:1; margin-left:5px; margin-right:5px; margin-top:32px;">
								<button class="" id='openssl_enc_button' style="flex-grow:1; " onclick="activateEncOpenSSL()">Encrypt<br>------></button>
								<button class="" id='openssl_dec_button' style="flex-grow:1; " onclick="activateDecOpenSSL()">Decrypt<br><------</button>
							</div>
							<div id="" style="display:flex; flex-direction:column; flex-grow:5; ">
								<div id="" style="display:flex; flex-direction:row; justify-content:space-between; ">
									<label id="openssl_ciphertext_label" style="align-self:flex-end;">Ciphertext:</label>
									<div id="" style="display:flex; flex-direction:column;  ">
										<label id="openssl_ciphertext_bytesize_label" style="color:gray; ">Bytes:</label>
									</div>
								</div>
								<textarea value="" id="openssl_ciphertext" style="" oninput="executeOpenSSL()"></textarea>
							</div>
						</div>
						<label id="openssl_outcome_message" style="visibility:hidden; color:red; align-self:center; margin-top:5px; ">Error: Decryption unsuccessful</label>
						<label style="">Password:</label>
						<input class="dev_site_password_input" autocomplete="off" type="" value="" id="openssl_password" style="" oninput="executeOpenSSL()">
					</div>
					<!--------------------------OpenSSL SECTION-------------------------------------!>

					<!--------------------------OBF-1000 SECTION-------------------------------------!>
					<div class="dev_site_sections" id="gcm1000_section" style="">
						<div style="position:relative; ">
							<div class="" id="gcm1000_tooltip" style="display:flex; position:absolute; z-index:2; top:50px; left:50px; display:none; background-color:#434343; border:5px solid gold; padding:5px;">
								<!------------------COPY IN TOOLTIP LATER------------------------->
								<p>
									OBF-1000 TOOLTIP SECTION
									<br>
									<br>
									<span style="color:magenta; ">No data is ever sent to any server!</span> All OBF functionality including OpenSSL, OBF-1000, AES-CTR is executed on the client side in the browser. You can check this yourself by turning internet off while keeping the browser up or by checking using the browser's developer tools (ctrl+shift+i in chrome based) and clicking on Network tab which shows all packets sent and received by the browser.
									<br>
									Specification Documentation:
									<br>
									<a href="https://developer.mozilla.org/en-US/docs/Web/API/SubtleCrypto/encrypt" target="_blank">encrypt() MDN Documentation</a><br>
									<a href="https://www.w3.org/TR/webcrypto/#aes-cbc" target="_blank">AES-CBC W3C Specification/Documentation</a><br>
									<a href="https://www.w3.org/TR/webcrypto/#aes-ctr" target="_blank">AES-CTR W3C Specification/Documentation</a><br>
									<a href="https://www.w3.org/TR/webcrypto/#SubtleCrypto-method-importKey" target="_blank">importKey() W3C Specification/Documentation</a><br>
									<a href="https://developer.mozilla.org/en-US/docs/Web/API/SubtleCrypto" target="_blank">SubtleCrypto Documentation</a><br>
									<a href="https://en.wikipedia.org/wiki/World_Wide_Web_Consortium" target="_blank">W3C Wiki</a><br>

								</p>
								<button class="glossy_button" onclick="hideTipOBF1000()">Close</button>
							</div>
						</div>
						<div style="display:flex;  ">
							<h3 id="gcm1000" style="scroll-margin-top:75px; ">OBF-1000</h3>
							<a class="glossy_icon" style="margin-top:13px; " href="javascript:void('show tooltip')" onclick="showTipOBF1000()">[?]</a>
						</div>
						<div class="textarea_div_heightcontrol" id="" style="display:flex; flex-direction:row; ">
							<div id="" style="display:flex; flex-direction:column; flex-grow:5; ">
								<div id="" style="display:flex; flex-direction:row; justify-content:space-between; ">
									<label id="gcm1000_cleartext_label" style="align-self:flex-end;">Cleartext:</label>
									<div id="" style="display:flex; flex-direction:column;  ">
										<label id="gcm1000_cleartext_bytesize_label" style="color:gray; ">Bytes:</label>
									</div>
								</div>
								<textarea value="" id="gcm1000_cleartext" style="" rows="8" oninput="executeOBF1000()"></textarea>
							</div>
							<div id="" style="display:flex; flex-direction:column; flex-grow:1; margin-left:5px; margin-right:5px; margin-top:33px;">
								<button class="" id='gcm1000_enc_button' style="flex-grow:1; " onclick="activateEncOBF1000()">Encrypt<br>------></button>
								<button class="" id='gcm1000_dec_button' style="flex-grow:1; " onclick="activateDecOBF1000()">Decrypt<br><------</button>
							</div>
							<div id="" style="display:flex; flex-direction:column; flex-grow:5; ">
								<div id="" style="display:flex; flex-direction:row; justify-content:space-between; ">
									<label id="gcm1000_ciphertext_label" style="align-self:flex-end;">Ciphertext:</label>
									<div id="" style="display:flex; flex-direction:column;  ">
										<label id="gcm1000_ciphertext_bytesize_label" style="color:gray; ">Bytes:</label>
									</div>
								</div>
								<textarea value="" id="gcm1000_ciphertext" style="" rows="8" oninput="executeOBF1000()"></textarea>
							</div>
						</div>
						<label id="gcm1000_outcome_message" style="visibility:hidden; color:red; align-self:center; margin-top:5px; ">Error: Decryption unsuccessful</label>
						<label>Password:</label>
						<input class="dev_site_password_input" autocomplete="off" type="" value="" id="gcm1000_password" style="" oninput="executeOBF1000()">
					</div>
					<!--------------------------OBF-1000 SECTION-------------------------------------!>

					<!--------------------------AES-CTR SECTION-------------------------------------!>
					<div class="dev_site_sections" id="aesctr_section" style="">
						<div style="position:relative; ">
							<div class="" id="aesctr_tooltip" style="display:flex; position:absolute; z-index:2; top:50px; left:50px; display:none; background-color:#434343; border:5px solid gold; padding:5px;">
								<!------------------COPY IN TOOLTIP LATER------------------------->
								<p>
									AES-CTR TOOLTIP SECTION
									<br>
									<br>
									<span style="color:magenta; ">No data is ever sent to any server!</span> All OBF functionality including OpenSSL, OBF-1000, AES-CTR is executed on the client side in the browser. You can check this yourself by turning internet off while keeping the browser up or by checking using the browser's developer tools (ctrl+shift+i in chrome based) and clicking on Network tab which shows all packets sent and received by the browser.
									<br>
									Specification Documentation:
									<br>
									<a href="https://developer.mozilla.org/en-US/docs/Web/API/SubtleCrypto/encrypt" target="_blank">encrypt() MDN Documentation</a><br>
									<a href="https://www.w3.org/TR/webcrypto/#aes-cbc" target="_blank">AES-CBC W3C Specification/Documentation</a><br>
									<a href="https://www.w3.org/TR/webcrypto/#aes-ctr" target="_blank">AES-CTR W3C Specification/Documentation</a><br>
