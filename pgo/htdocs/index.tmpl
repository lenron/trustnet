	// Return true if input only contains uuid chars which are used for passlock and browserID.
	function checkUUIDChars(input) {
		const regex = new RegExp(/^[a-f0-9-]*$/);
		if (regex.test(input)) {
			return true;
		}else{
			return false;
		}
	}// checkUUIDChars()

	// Return true if input only contains base64 chars, including padding char: '='
	function checkBase64Chars(input) {
		const regex = new RegExp(/^[a-zA-Z0-9+=\/]*$/);
		if (regex.test(input)) {
			// Return true/valid
			return true;
		}else{
			// Return false/invalid
			return false;
		}
	}// checkBase64Chars()

	function checkDataLength(data, length) {
		// Return fail if data length surpasses length.
		if (data.length > length) {
			console.log("Data length Invalid!");
			return false;
		} else {
			return true;
		}
	}

	function checkLengthAndBase64(data, length){
		if (!checkDataLength(data, length) || !checkBase64Chars(data)){
			throw new Error('INVALID LENGTH OR NON-BASE64 CHARS FOUND ON INTERNAL DATAPATH!');
		} 
	}

	// Input: input is a string.
	// Output: Returns false if the input length (in bytes) is over OPENSSL_INPUT_LIMIT_BYTES: 686
	function checkDataInputLengthWithRegex(input) {
		// Get input size in bytes.
		let size = new Blob([input]).size;
		let difference = OPENSSL_INPUT_LIMIT_BYTES - size;
		// Show running count of data length.
		let size_string = "Byte length remaining: " + difference;
		document.getElementById("browserdata_length_label").innerHTML = size_string;
		document.getElementById("editdata_length_label").innerHTML = size_string;
		if (size > OPENSSL_INPUT_LIMIT_BYTES) {
			return false; // Length Check Failed.
		}else{
			return true; // Length Check Passed.
		}
	}// checkDataInputLengthWithRegex()

	// Input: input is a string.
	// Output: Returns false if the input length (in bytes) is over 544.
	function checkInputLengthUpload(input) {
		// show input size in bytes
		let size = new Blob([input]).size;
		let difference = OBF_1000_INPUT_LIMIT_BYTES - size;
		// Show running count of data length.
		let size_string = "Byte length remaining: " + difference;
		//console.log("size_string: " + size_string);
		document.getElementById("uploaddata_length_label").innerHTML = size_string;
		if (size > OBF_1000_INPUT_LIMIT_BYTES) {
			return false; // Length Check Failed.
		}else{
			return true; // Length Check Passed.
		}
	}// checkInputLengthUpload()

	// Returns true if input has precisely FINGERPRINT_LENGTH_BASE64 (43) base64 chars.
	function checkFingerprintIsValid(fingerprint) {
		// Need backticks to wrap regex inside constructor call so that global constant variable FINGERPRINT_LENGTH_BASE64 can be passed in.
		const regex = new RegExp(`^[A-Za-z0-9+/=]{${FINGERPRINT_LENGTH_BASE64}}$`);
		if (regex.test(fingerprint)) {
			return true;
		}else{
			return false;
		}
	}// checkFingerprintIsValid()

	// Returns true if input has precisely MULTI_ENCRYPTED_DATARECORD_LENGTH_BASE64 (1024) base64 chars.
	function checkDataIsValid(data) {
		const regex = new RegExp(`^[A-Za-z0-9+/=]{${MULTI_ENCRYPTED_DATARECORD_LENGTH_BASE64}}$`);
		if (regex.test(data)) {
			return true;
		}else{
			return false;
		}
	}// checkDataIsValid()

	function checkFingerprintAndData(fingerprint, multiEncryptedDatarecord) {
		if (!checkFingerprintIsValid(fingerprint)) {
			throw new Error('Attempt to store failed! FINGERPRINT is invalid.');
		}else{
			console.log("FINGERPRINT IS VALID!");
		}
		if (!checkDataIsValid(multiEncryptedDatarecord)) {
			throw new Error('Attempt to store failed! DATA is invalid.');
		}else{
			console.log("DATA IS VALID!");
		}
	}

