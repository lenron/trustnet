	///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Base Functionality:  Produce a 'Fingerprint' which will be used as the Key in the Key-Value pair for storing a Multi Encrypted Datarecord.
	//                      This is achieved by SHA-256 hashing inputs, concatenating them, and finally returning a hash of that concatenation.
	//
	//	Inputs structure:	codeword:    human readable plaintext string
	//						obf1000Pass: human readable plaintext string
	//						ctrPass:     human readable plaintext string
	//
	//	Output structure:	43 base64 char string
	//
	async function computeFingerprint(codeword, obf1000Pass, ctrPass) {
		// Convert codeword to lowercase.
		const codewordLower = codeword.toLowerCase();
		// Create a new TextEncoder object.
		const enc = new TextEncoder();
		// Convert human readable plaintext string to Uint8Array.
		const codewordUint8 = enc.encode(codewordLower);
		const obf1000PassUint8 = enc.encode(obf1000Pass);
		const ctrPassUint8 = enc.encode(ctrPass);
		// Compute SHA-256 hash.
		const codewordHash = await crypto.subtle.digest('SHA-256', codewordUint8);
		const obf1000PassHash = await crypto.subtle.digest('SHA-256', obf1000PassUint8);
		const ctrPassHash = await crypto.subtle.digest('SHA-256', ctrPassUint8);
		// Concatenate: fingerprint = codewordHash + obf1000PassHash + ctrPassHash
		const codeword_and_obf1000PassHash = concatBuffer(codewordHash, obf1000PassHash)
		const concatenatedHashes = concatBuffer(codeword_and_obf1000PassHash, ctrPassHash)
		// SHA-256 hash the result.
		const fingerprintHash = await crypto.subtle.digest('SHA-256', concatenatedHashes);
		const fingerprint = new Uint8Array(fingerprintHash);
		// omitPadding used here to remove a single '=' char, leaving us with a length of 43 for fingerprints.
		const b64 = fingerprint.toBase64({omitPadding: true});
		return b64;
	}// computeFingerprint()


	//////////////////////////////////////////////////////////////
	//			Server Communication Functions				    //
	//////////////////////////////////////////////////////////////
	// Server communication relies on fetch() to handle HTTP requests.
	//////////////////////////////////////////////////////////////

	//////////////////////////////////////////////////////////////
	// We need to set the origin differently depending if we're a standalone file or not.
	// This function checks our origin and sets it to the server url to enable server functionality for a standalone.html.
	// Returns the SERVER_URL to be used for server communication functions.
	// 
	// This function used by both online client and offline standalone.html file that houses the offline database.
	// While the online client can find there the online database is to store using window.location.origin,
	// the offline database needs to have that URL set manually by this function.
	// 
	// Figure out whether we are an online client of offline database housing standalone.html file
	// and set the origin accordingly so that communication with the online server will work.
	function getOnlineServerOrigin() {
		// Get origin detected by the browser.
		const browserDetectedOrigin = window.location.origin;
		let onlineServerOrigin = '';
		// If we're standalone, set address manually.
		const regex = new RegExp(/^file/);
		if (regex.test(browserDetectedOrigin)) {
			// This is a standalone file; set origin manually.
			onlineServerOrigin = 'https://obf.mkrsvr.org/';
		}else{
			// This an online client, empty in this context gets interpreted as 'this origin' by fetch() when used.
			onlineServerOrigin = '';
		}
		return onlineServerOrigin;
	}// getOnlineServerOrigin()

	// Check if we're online by querying server.
	async function checkOnline() {
		// Get origin of the online server.
		let SERVER_URL = getOnlineServerOrigin();
		SERVER_URL += 'exeonlinecheck';

		try { // Catch a rejected promise so we can operate on it.
			// Execute HTTP request to SERVER_URL with the following options.
			const fetchResponseObject = await fetch(SERVER_URL, {
				method: 'POST',
				headers: {
					'Content-Type': 'text/plain',
				}
			});

			if (!fetchResponseObject.ok) { // Indicates HTTP error.
				// Response Status is the numerical code like 404, 500, etc.
				return 'offline';
			}
			// Looks like we're online!
			return 'online';
		//Can be triggered by: a DNS failure, connection timeout, or the user being offline.
		} catch (error) { // Catch rejected promise.
			// If we're in this error block we know that it is a communication/offline error. Yes this is arcane knowledge.
			console.log("Fetch Error on Online Check: " + error.message);
			console.log("response FAILED");
			return "offline";
		}
	}// checkOnline()

	// Check if we're online or not and inform user by changing UI label that is always visible as user moves through interface.
	async function updateOnlineStatus() {
		document.getElementById("offline_label").innerHTML = "ONLINE STATUS PENDING...";
		// Check if we're online
		const online_status = await checkOnline();
		if (online_status === "online") {
			document.getElementById("offline_label").innerHTML = "YOU'RE ONLINE";
		}else{
			document.getElementById("offline_label").innerHTML = "YOU'RE OFFLINE. SERVER WILL NOT BE UPDATED WITH ANY NEW SAVES.";
		}
	}// updateOnlineStatus()

	// Endpoint /obf/exeload will attempt to load encrypted data corresponding to the input fingerprint.
	// Input: fingerprint is hexadecimal.
	// Output: POST message to server script which will attempt to load encrypted data from server database.
	//
	// Accesses the Multi Encrypted Datarecord at fingerprint location from the online server and returns it. 
	async function serverLoad(fingerprint) {
		let SERVER_URL = getOnlineServerOrigin();
		SERVER_URL += 'exeload';

		try { // Catch a rejected promise so we can operate on it.
			// Execute HTTP request to SERVER_URL with the following options.
			const fetchResponseObject = await fetch(SERVER_URL, {
				method: 'POST',
				headers: {
					'Content-Type': 'text/plain',
				},
				body: JSON.stringify({ // Convert javascript JSON object into string for transport.
					fingerprint: fingerprint,
				}),
			});

			if (!fetchResponseObject.ok) { // Indicates HTTP error.
				// Response Status is the numerical code like 404, 500, etc.
			}
			// Now that we've cleared the error check, we can proceed with processing the response.
			// Make a copy of the json extraction.
			const responseObj = await fetchResponseObject.json();
			if (responseObj.access_response === "TOO_MANY_ACCESS_FAILURES" || responseObj.access_response === "NOT_FOUND") {
				console.log("serverLoad Error: " + responseObj.access_response);
				return responseObj.access_response;
			} else if (responseObj.access_response.length === MULTI_ENCRYPTED_DATARECORD_LENGTH_BASE64 && checkBase64Chars(responseObj.access_response)) { // Data looks good.
				console.log("serverLoad: Successfully loaded encrypted data.");
				return responseObj.access_response;
			} else {
				console.log("serverLoad Error: " + responseObj.access_response);
			}
		//Can be triggered by: a DNS failure, connection timeout, or the user being offline.
		} catch (error) { // Catch rejected promise.
			console.error(error.message);
		}
	}// serverLoad()

	// Stores Multi Encrypted Datarecord to fingerprint location in the online database.
	async function serverStore(fingerprint, data) {
		let SERVER_URL = getOnlineServerOrigin();
		SERVER_URL += 'exestore';
		
		try { // Catch a rejected promise so we can operate on it.
			// Execute HTTP request to SERVER_URL with the following options.
			const fetchResponseObject = await fetch(SERVER_URL, {
				method: 'POST',
				headers: {
					'Content-Type': 'text/plain',
				},
				body: JSON.stringify({ // Convert javascript JSON object into string for transport.
					fingerprint: fingerprint,
					data: data,
				}),
			});

			if (!fetchResponseObject.ok) { // Indicates HTTP error.
				// Response Status is the numerical code like 404, 500, etc.
			}
			// Now that we've cleared the error check, we can proceed with processing the response.
			// Make a copy of the json extraction.
			const responseObj = await fetchResponseObject.json();
			console.log("Store responseObj.response: " + responseObj.store_response);
			if (responseObj.store_response === "TOTAL_STORES_OVER_50000") {
				showPage("lockedout_50000"); // Shown for a split second before page reload.
				window.location.reload(true);
				throw new Error("TOTAL_STORES_OVER_50000");
			} else if (responseObj.store_response === "SUCCESS") {
				console.log("serverStore: Successfully stored encrypted data.");
				return "success";
			} else if (responseObj.store_response === "STORES_OVER_100") {
				return "STORES_OVER_100";
			} else if (responseObj.store_response === "STORE FAILED") {
				throw Error("serverStore Error! Database failed to store data.");
			} else {
				throw Error("serverStore Error! Maybe a database error?");
			}
		//Can be triggered by: a DNS failure, connection timeout, or the user being offline.
		// 500 Internal Server Errors will be caught here too.
		}catch(error) { // Catch rejected promise.
			console.error(error.message);
		}
	}// serverStore()

	// Endpoint /obf/exedelete will attempt to delete.
	// Input: fingerprint is hexadecimal.
	// Output: POST message to server script that will attempt to Delete.
	// 
	// Deletes the Multi Encrypted Datarecord at fingerprint location.
	async function serverDelete(fingerprint) {
		let SERVER_URL = getOnlineServerOrigin();
		SERVER_URL += 'exedelete';
		
		try { // Catch a rejected promise so we can operate on it.
			// Execute HTTP request to SERVER_URL with the following options.
			const fetchResponseObject = await fetch(SERVER_URL, {
				method: 'POST',
				headers: {
					'Content-Type': 'text/plain',
				},
				body: JSON.stringify({ // Convert javascript JSON object into string for transport.
					fingerprint: fingerprint,
				}),
			});

			if (!fetchResponseObject.ok) { // Indicates HTTP error.
				// Response Status is the numerical code like 404, 500, etc.
			}
			// Now that we've cleared the error check, we can proceed with processing the response.
			// Make a copy of the json extraction.
			const responseObj = await fetchResponseObject.json();
			if (Number(responseObj.response) !== 1) { // there appears to be a problem.
				throw Error("serverDelete Error! Data not deleted!");
				return "error";
			}else{
				console.log("serverDelete: Successfully deleted data.");
				return "success";
			}
		//Can be triggered by: a DNS failure, connection timeout, or the user being offline.
		// 500 Internal Server Errors will be caught here too.
		}catch(error) { // Catch rejected promise.
			console.error(error.message);
		}
	}// serverDelete()

	function clearSaveToDiskReminder() {
		document.getElementById("savetodisk_warning").style.display = "none";
	}

	function setSaveToDiskReminder() {
		document.getElementById("savetodisk_warning").style.display = "flex";
	}

	// Gonna need this functionality in order to store to disk.
	//
	// Grab currently running HTML and save it to standalone.html
	// This saves the offline dbase in addition to creating and downloading a standalone version that can be used offline.
	function saveToDisk() {
		// Clear reminder flag first or it will be active in saved file.
		clearSaveToDiskReminder();

		// This line doesn't get applied with the innerHTML call below so add it manually.
		let allhtml = "<!DOCTYPE HTML>";
		// This will grab a copy of the currently running HTML.
		allhtml += document.querySelector("html").innerHTML;
		//console.log(allhtml);
		let element = document.createElement('a');
		element.setAttribute('href', 'data:text/plain;charset=utf-8,' + encodeURIComponent(allhtml));
		element.setAttribute('download', 'standalone.html');
		element.style.display = 'none';
		document.body.appendChild(element);
		element.click();
		document.body.removeChild(element);
	}

