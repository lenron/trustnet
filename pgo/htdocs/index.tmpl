	// Catch File Ingest
	// listener is placed inline of the html
	async function catchUpload(event) {
		const file = event.target.files[0];
		const reader = new FileReader();
		reader.readAsArrayBuffer(file);

		reader.onload = async function(e) {
			let buffer = e.target.result;
			const buffer_uint8a = new Uint8Array(buffer);
			let filedata = buffer_uint8a.toBase64();
			//console.log("filedata: " + filedata);
			// Input Data Length Check
			if (checkInputLengthUpload(buffer)) {
				// Saving data without passlock encryption for Offline Flow usage.
				offlineData['data'] = filedata;
				// Show button.
				document.getElementById("offlinestore_upload_commit_button").style.display = "inline";
				document.getElementById("offlinestore_upload_input").style.border = "";
				// Tell user we are READY TO COMMIT. 
				document.getElementById("offlinestore_upload_readytocommit").style.display = "inline";
				// add red warning text
				document.getElementById("offlinestore_upload_warning").style.display = "none";
			}else{
				// Data Length too long! Show Warning.
				// hide continue button
				document.getElementById("offlinestore_upload_commit_button").style.display = "none";
				// make border red
				document.getElementById("offlinestore_upload_input").style.border = "thick solid red";
				// add red warning text
				document.getElementById("offlinestore_upload_warning").style.display = "inline";
			}
		}
		console.log("File input contents: " + document.getElementById('offlinestore_upload_input').value);
		document.getElementById('offlinestore_upload_input').value = null;
		console.log("File input contents: " + document.getElementById('offlinestore_upload_input').value);
	}

	// Called on change of text area, checks length of that text area and shows warning if input data too long.
	function checkDataInputLength(input_id) {
		//let input = document.getElementById("store_data").value;
		let input = document.getElementById(input_id).value;
		if (checkDataInputLengthWithRegex(input)) {
			// Length OK, turn off warning
			document.getElementById("text_input_warning").style.display = "none";
			// display button
			document.getElementById("text_input_continue").style.display = "inline";

			// Length OK, turn off warning
			document.getElementById("edit_input_warning").style.display = "none";
			// display button
			document.getElementById("offline_save_button").style.display = "inline";
		}else{
			// Length NOT OK, turn ON warning
			document.getElementById("text_input_warning").style.display = "inline";
			// remove button
			document.getElementById("text_input_continue").style.display = "none";

			// Length NOT OK, turn ON warning
			document.getElementById("edit_input_warning").style.display = "inline";
			// remove button
			document.getElementById("offline_save_button").style.display = "none";
		}
	}

	// Randomly generate a single Multi Encrypted Datarecord worth of junk data.
	function getRandMultiEncryptedDatarecord() {
		// This value that will convert to 1024 base64 chars.
		const randarray = window.crypto.getRandomValues(new Uint8Array(MULTI_ENCRYPTED_DATARECORD_LENGTH_BYTES));
		return randarray.toBase64();
	}// getRandMultiEncryptedDataRecord()

	// Randomly generate 43 base64 chars of junk data.
	function getRandFingerprint() {
		// 32 bytes is the output of SHA-256
		const randarray = window.crypto.getRandomValues(new Uint8Array(FINGERPRINT_LENGTH_BYTES));
		// omitPadding used here to remove a single '=' char, leaving us with a length of 43 for fingerprints.
		return randarray.toBase64({omitPadding: true});
	}// getRandFingerprint()

	// Returns true if input has precisely FINGERPRINT_LENGTH_BASE64 (43) base64 chars.
	function checkFingerprintIsValid(fingerprint) {
		// Need backticks to wrap regex inside constructor call so that global constant variable FINGERPRINT_LENGTH_BASE64 can be passed in.
		const regex = new RegExp(\`^[A-Za-z0-9+/=]{\${FINGERPRINT_LENGTH_BASE64}}$\`); // !@#
		if (regex.test(fingerprint)) {
			return true;
		}else{
			return false;
		}
	}

	// Returns true if input has precisely MULTI_ENCRYPTED_DATARECORD_LENGTH_BASE64 (1024) base64 chars.
	function checkDataIsValid(data) {
		const regex = new RegExp(\`^[A-Za-z0-9+/=]{\${MULTI_ENCRYPTED_DATARECORD_LENGTH_BASE64}}$\`); // !@#
		if (regex.test(data)) {
			return true;
		}else{
			return false;
		}
	}

	// Input: input is a string.
	// Output: Returns false if non-base58 characters are detected.
	function checkBase64Chars(input) {
		// From the first char(^) to the last($), match base64 chars.
		const regex = new RegExp(/^[a-zA-Z0-9+=\/]*$/);
		if (regex.test(input)) {
			// Return true/valid
			return true;
		}else{
			// Return false/invalid
			return false;
		}
	}//checkBase64Chars()

	function checkDataLength(data, length) {
