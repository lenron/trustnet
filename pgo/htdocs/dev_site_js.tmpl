	// Passes data to core crypto functions in order to be encrypted or decrypted, then displays the outcome of processing that data.
	async function executeTriple() {
		// Encrypt/Decrypt buttons set this flag which determines encrypt or decrypt function.
		if (tripleEncrypt_f === true) { // Encrypt function
			// Gather inputs.
			const plaintext = document.getElementById('triple_plaintext').value;
			const password1GCM = document.getElementById('triple_password_1').value;
			const password2CTR = document.getElementById('triple_password_2').value;
			const password3OpenSSL = document.getElementById('triple_password_3').value;
			// If encrypt fails, display outcome to user instead of erroring.
			try {
				// Execute crypto function with wrapper, enabling enc/dec of human readable text. Place result in corresponding textarea.
				document.getElementById('triple_ciphertext').value = await encryptTriple(password1GCM, password2CTR, password3OpenSSL, plaintext);
				// Make outcome message visible.
				document.getElementById('triple_outcome_message').style.visibility = 'visible';
				// Set the text color.
				document.getElementById('triple_outcome_message').style.color = 'lime';
				// Place specified text inside this element.
				document.getElementById('triple_outcome_message').innerHTML = 'SUCCESSFULLY ENCRYPTED';
			} catch (error) {
				console.log(error);
				// Make outcome message visible.
				document.getElementById('triple_outcome_message').style.visibility = 'visible';
				// Set the text color.
				document.getElementById('triple_outcome_message').style.color = 'red';
				// Place specified text inside this element.
				document.getElementById('triple_outcome_message').innerHTML = 'Error: Encryption unsuccessful';
				// Only show correct ciphertext.
				document.getElementById('triple_ciphertext').value = '';
			}
		} else { // Decrypt function
			// Gather inputs.
			const ciphertext = document.getElementById('triple_ciphertext').value;
			const password1GCM = document.getElementById('triple_password_1').value;
			const password2CTR = document.getElementById('triple_password_2').value;
			const password3OpenSSL = document.getElementById('triple_password_3').value;
			// If decrypt fails, display outcome to user instead of erroring.
			try {
				// Execute crypto function with wrapper, enabling enc/dec of human readable text. Place result in corresponding textarea.
				document.getElementById('triple_plaintext').value = await decryptTriple(password1GCM, password2CTR, password3OpenSSL, ciphertext);
				// Make outcome message visible.
				document.getElementById('triple_outcome_message').style.visibility = 'visible';
				// Set the text color.
				document.getElementById('triple_outcome_message').style.color = 'lime';
				// Place specified text inside this element.
				document.getElementById('triple_outcome_message').innerHTML = 'SUCCESSFULLY DECRYPTED';
			} catch (error) {
				console.log(error);
				// Make outcome message visible.
				document.getElementById('triple_outcome_message').style.visibility = 'visible';
				// Set the text color.
				document.getElementById('triple_outcome_message').style.color = 'red';
				// Place specified text inside this element.
				document.getElementById('triple_outcome_message').innerHTML = 'Decryption unsuccessful';
				// Only show correct plaintext.
				document.getElementById('triple_plaintext').value = '';
			}
		}
		// Deactivate pending timer before creating a new one.
		clearTimeout(timeoutIdTriple)
		// Create timer that will turn off outcome message after 2 seconds.
		timeoutIdTriple = setTimeout(() => {
			// Turn off outcome message.
			turnOffTripleDecryptOutcomeMessage();
		}, 2000); 
		// Compute length value after execution (when we have the correct values to check the length of).
		setLengthTriple();
	}// executeTriple()

