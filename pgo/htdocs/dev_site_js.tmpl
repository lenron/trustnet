	// HMTL is set up in 2 divs that sit alongside each other where only 1 is meant to be on at once.
	// This toggle page function switches controls the display property of those divs, effectively switching to Dev Site and back.
	// Can be used to add FAQ, mail sections if needed.
	//
	// Maybe change this to include an input parameter 'dev_site', 'faq', etc. if we move to that.
	let main_page = true;
	function toggleDevSite() {
		if (main_page) {
			// Switch to Dev site. Change link name to MAIN_SITE
			document.getElementById("dev_site_toggle_link").innerHTML = "MAIN_SITE";
			document.getElementById("dev_site").style.display = "flex";
			document.getElementById("main_page").style.display = "none";
			main_page = false;
		} else {
			// Switch to Main site. Change link name to DEV_SITE
			document.getElementById("dev_site_toggle_link").innerHTML = "DEV_SITE";
			document.getElementById("dev_site").style.display = "none";
			document.getElementById("main_page").style.display = "flex";
			main_page = true;
		}
	}

	/////////////// 
	function turnOffPinkBar() {
		document.getElementById('openssl_sidebar_text').style.color = '#54c597';
		document.getElementById('gcm1000_sidebar_text').style.color = '#54c597';
		document.getElementById('aesctr_sidebar_text').style.color = '#54c597';
		document.getElementById('triple_sidebar_text').style.color = '#54c597';
	}

	function turnOnPinkBarOpenSSL() {
		document.getElementById('openssl_sidebar_text').style.color = 'magenta';
	}
	function turnOnPinkBarOBF1000() {
		document.getElementById('gcm1000_sidebar_text').style.color = 'magenta';
	}
	function turnOnPinkBarAESCTR() {
		document.getElementById('aesctr_sidebar_text').style.color = 'magenta';
	}
	function turnOnPinkBarTriple() {
		document.getElementById('triple_sidebar_text').style.color = 'magenta';
	}

	// A read-only property scrollY of the Window interface returns the number of pixels by which the document is currently scrolled vertically. (paraphrasing MDN https://developer.mozilla.org/en-US/docs/Web/API/Window/scrollY)
	// So, the further the user scrolls from the top of the page, the larger the value will be.
	// We use this value to set the location of the 'pink bar' which is intended to indicate to the user which section they are in. 
	// This listener fires an unnammed function which sets the pink bar in real-time.
	window.addEventListener("scroll", (event) => {
		let scroll = window.scrollY;

		if (scroll < 500) {
			turnOffPinkBar();
			turnOnPinkBarOpenSSL();
		} else if (scroll >= 500 && scroll < 1000){
			turnOffPinkBar();
			turnOnPinkBarOBF1000();
		} else if (scroll >= 1000 && scroll < 1500){
			turnOffPinkBar();
			turnOnPinkBarAESCTR();
		} else if (scroll >= 1500){
			turnOffPinkBar();
			turnOnPinkBarTriple();
		}
	});

