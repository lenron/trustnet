	///////////////////////////////////////////////////////////////////////////////////
	//						Magenta Scroll Bar Highlighting                          //
	///////////////////////////////////////////////////////////////////////////////////
	// The magenta highlight on the sidebar is turned on and off as the user scrolls the page.
	//
	// This function turns off all pink bars.
	function turnOffPinkBar() {
		document.getElementById('openssl_sidebar_text').style.color = siteColor;
		document.getElementById('gcm1000_sidebar_text').style.color = siteColor;
		document.getElementById('aesctr_sidebar_text').style.color = siteColor;
		document.getElementById('triple_sidebar_text').style.color = siteColor;
	}// turnOffPinkBar()

	// This set of functions each turn on their corresponding bar.
	function turnOnPinkBarOpenSSL() {
		document.getElementById('openssl_sidebar_text').style.color = 'magenta';
	}// turnOnPinkBarOpenSSL()
	function turnOnPinkBarOBF1000() {
		document.getElementById('gcm1000_sidebar_text').style.color = 'magenta';
	}// turnOnPinkBarOBF1000()
	function turnOnPinkBarAESCTR() {
		document.getElementById('aesctr_sidebar_text').style.color = 'magenta';
	}// turnOnPinkBarAESCTR()
	function turnOnPinkBarTriple() {
		document.getElementById('triple_sidebar_text').style.color = 'magenta';
	}// turnOnPinkBarTriple()

	////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// https://developer.mozilla.org/en-US/docs/Web/API/Window/scrollY
	// A read-only property scrollY of the Window interface returns the number of pixels by which the document is currently scrolled vertically.
	// So, the further the user scrolls from the top of the page, the larger the value will be.
	// We use this value to set the location of the 'pink bar' which is indicates to the user which section they are in. 
	// This listener fires an unnammed function which sets the pink bar in real-time.
	window.addEventListener("scroll", (event) => {
		let scroll = window.scrollY;

		if (scroll < 500) {
			turnOffPinkBar();
			turnOnPinkBarOpenSSL();
		} else if (scroll >= 500 && scroll < 1000){
			turnOffPinkBar();
			turnOnPinkBarOBF1000();
		} else if (scroll >= 1000 && scroll < 1500){
			turnOffPinkBar();
			turnOnPinkBarAESCTR();
		} else if (scroll >= 1500){
			turnOffPinkBar();
			turnOnPinkBarTriple();
		}
	}); // Scroll Listener

