	///////////////////////////////////////////////////////////////////////////////
	//					OpenSSL HTML handling									 //
	///////////////////////////////////////////////////////////////////////////////

	// Wrapper/converter function allowing human readable text to be encrypted (base functions operate on base64).
	async function utf8EncryptOpenSSL(plaintext, password) {
		const plaintext64 = utf8ToBase64(plaintext);
		return await encryptOpenSSL(plaintext64, password);
	}// utf8EncryptOpenSSL()

	// Wrapper/converter function allowing decryption directly to human readable text (base functions operate on base64).
	async function utf8DecryptOpenSSL(ciphertext, password) {
		const plaintext64 = await decryptOpenSSL(ciphertext, password);
		return base64ToUtf8(plaintext64);
	}// utf8DecryptOpenSSL()

	// Passes data to core crypto functions in order to be encrypted or decrypted, then displays the outcome of processing that data.
	async function executeOpenSSL() {
		// Encrypt/Decrypt buttons set this flag which determines encrypt or decrypt function.
		if (openSSLEncrypt_f === true) { // Encrypt function
			// Gather inputs.
			const plaintext = document.getElementById('openssl_plaintext').value;
			const password = document.getElementById('openssl_password').value;
			// If encrypt fails, display outcome to user instead of erroring.
			try {
				// Execute crypto function with wrapper, enabling enc/dec of human readable text. Place result in corresponding textarea.
				document.getElementById('openssl_ciphertext').value = await utf8EncryptOpenSSL(plaintext, password);
				// Make outcome message visible.
				document.getElementById('openssl_outcome_message').style.visibility = 'visible';
				// Set the text color.
				document.getElementById('openssl_outcome_message').style.color = 'lime';
				// Place specified text inside this element.
				document.getElementById('openssl_outcome_message').innerHTML = 'SUCCESSFULLY ENCRYPTED';
			} catch (error) {
				console.log(error);
				// Make outcome message visible.
				document.getElementById('openssl_outcome_message').style.visibility = 'visible';
				// Set the text color.
				document.getElementById('openssl_outcome_message').style.color = 'red';
				// Place specified text inside this element.
				document.getElementById('openssl_outcome_message').innerHTML = 'Error: Encryption unsuccessful';
				// Only show correct ciphertext.
				document.getElementById('openssl_ciphertext').value = '';
			}
		} else { // Decrypt function
			// Gather inputs.
			const ciphertext = document.getElementById('openssl_ciphertext').value;
			const password = document.getElementById('openssl_password').value;
			// If decrypt fails, display outcome to user instead of erroring.
			try {
				// Execute crypto function with wrapper, enabling enc/dec of human readable text. Place result in corresponding textarea.
				document.getElementById('openssl_plaintext').value = await utf8DecryptOpenSSL(ciphertext, password);
				// Make outcome message visible.
				document.getElementById('openssl_outcome_message').style.visibility = 'visible';
				// Set the text color.
				document.getElementById('openssl_outcome_message').style.color = 'lime';
				// Place specified text inside this element.
				document.getElementById('openssl_outcome_message').innerHTML = 'SUCCESSFULLY DECRYPTED';
			} catch (error) {
				console.log(error);
				// Make outcome message visible.
				document.getElementById('openssl_outcome_message').style.visibility = 'visible';
				// Set the text color.
				document.getElementById('openssl_outcome_message').style.color = 'red';
				// Place specified text inside this element.
				document.getElementById('openssl_outcome_message').innerHTML = 'Decryption unsuccessful';
				// Only show correct plaintext.
				document.getElementById('openssl_plaintext').value = '';
			}
		}
		// Deactivate pending timer before creating a new one.
		clearTimeout(timeoutIdOpenSSL)
		// Create timer that will turn off outcome message after 2 seconds.
		timeoutIdOpenSSL = setTimeout(() => {
			// Turn off outcome message.
			turnOffOpenSSLDecryptOutcomeMessage();
		}, 2000); 
		// Compute length value after execution (when we have the correct values to check the length of).
		setLengthOpenSSL();
	}// executeOpenSSL()

	// By keeping track of a timeout ID, we can turn off the message before time has elapsed when the function is executed before timeout ends.
	let timeoutIdOpenSSL;
	// Compute then show the length of plaintext and ciphertext in the UI.
	function setLengthOpenSSL() {
		// Cleartext 
		const plaintext = document.getElementById('openssl_plaintext').value;
		// Compute the number of bytes used to represent displayed text.
		const plaintextByteSize = new Blob([plaintext]).size;
		// Compile string text to be shown.
		const plaintext_bytesize_string = "Bytes: " + plaintextByteSize;
		// Display string text.
		document.getElementById('openssl_plaintext_bytesize_label').innerHTML = plaintext_bytesize_string;
		// Ciphertext
		const ciphertext = document.getElementById('openssl_ciphertext').value;
		// Compute the number of bytes used to represent displayed text.
		const ciphertextByteSize = new Blob([ciphertext]).size;
		// Compile string text to be shown.
		const ciphertext_bytesize_string = "Bytes: " + ciphertextByteSize;
		// Display string text.
		document.getElementById('openssl_ciphertext_bytesize_label').innerHTML = ciphertext_bytesize_string;
	}// setLengthOpenSSL()

	// Turn off outcome message.
	function turnOffOpenSSLDecryptOutcomeMessage() {
		document.getElementById('openssl_outcome_message').style.visibility = 'hidden';
	}// turnOffOpenSSLDecryptOutcomeMessage()

	// Activate Encrypt UI.
	function showActiveEncOpenSSL() {
		// Disable decrypt.
		// Change button text to disabled color.
		document.getElementById('openssl_dec_button').style.color = 'dimgray';
		// Change outline, label to disabled color.
		document.getElementById('openssl_ciphertext_label').style.color = 'gray';
		document.getElementById('openssl_ciphertext').style.color = 'gray';
		document.getElementById('openssl_ciphertext').style.borderColor = 'gray';
		// Disable ciphertext textarea.
		document.getElementById('openssl_ciphertext').disabled = true;

		// Enable encrypt.
		// Change button text to enabled color.
		document.getElementById('openssl_enc_button').style.color = 'lime';
		// Change outline, label to enabled color.
		document.getElementById('openssl_plaintext_label').style.color = siteColor;
		document.getElementById('openssl_plaintext').style.color = siteColor;
		document.getElementById('openssl_plaintext').style.borderColor = siteColor;
		// Enable plaintext textarea.
		document.getElementById('openssl_plaintext').disabled = false;
	}// showActiveEncOpenSSL()

	// Activate Encrypt UI when user focuses the Encrypt side textarea.
	function activateEncOpenSSL() {
		// Set flag
		openSSLEncrypt_f = true;
		// Turn off decryption error.
		document.getElementById('openssl_outcome_message').style.visibility = 'hidden';
		// Use function for code re-use. showActive functions used for when user clicks password.
		showActiveEncOpenSSL();
		// Focus newly active textarea
		document.getElementById('openssl_plaintext').focus();
		// Execute crypto on button click.
		executeOpenSSL();
	}// activateEncOpenSSL()

	// Activate Decrypt UI.
	function activateDecOpenSSL() {
		// Set flag
		openSSLEncrypt_f = false;
		// Enable decrypt - ciphertext.
		// Change button text to enabled color.
		document.getElementById('openssl_dec_button').style.color = 'lime';
		// Change outline, label to disabled color.
		document.getElementById('openssl_ciphertext_label').style.color = siteColor;
		document.getElementById('openssl_ciphertext').style.color = siteColor;
		document.getElementById('openssl_ciphertext').style.borderColor = siteColor;
		// Enable plaintext textarea.
		document.getElementById('openssl_ciphertext').disabled = false;
		// Disable encrypt - plaintext.
		// Change button text to disabled color.
		document.getElementById('openssl_enc_button').style.color = 'dimgray';
		// Change outline, label to enabled color.
		document.getElementById('openssl_plaintext_label').style.color = 'gray';
		document.getElementById('openssl_plaintext').style.color = 'gray';
		document.getElementById('openssl_plaintext').style.borderColor = 'gray';
		// Disable ciphertext textarea.
		document.getElementById('openssl_plaintext').disabled = true;
		// Focus newly active textarea
		document.getElementById('openssl_ciphertext').focus();
		// Execute crypto on button click.
		executeOpenSSL();
	}// activateDecOpenSSL()

