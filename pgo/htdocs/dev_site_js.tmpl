	// When a user focuses a window we 'activate' it, immediately taking input in that window as plaintext for encrypt or ciphertext for decrypt (depending on the window). 
	// This set of listeners handle activating the proper function for the window that was focused.
	//
	// OpenSSL
	document.getElementById('openssl_plaintext').addEventListener("focus", (event) => {
		activateEncOpenSSL();
	});
	document.getElementById('openssl_ciphertext').addEventListener("focus", (event) => {
		activateDecOpenSSL();
	});
	document.getElementById('openssl_password').addEventListener("focus", (event) => {
		// When password input field is focused, choose either encrypt or decrypt side based on current state.
		// True here indicates encrypt side.
		if (openSSLEncrypt_f) {
			showActiveEncOpenSSL();
		}
	});
	// GCM-1000
	document.getElementById('gcm1000_plaintext').addEventListener("focus", (event) => {
		activateEncOBF1000();
	});
	document.getElementById('gcm1000_ciphertext').addEventListener("focus", (event) => {
		activateDecOBF1000();
	});
	document.getElementById('gcm1000_password').addEventListener("focus", (event) => {
		// True here indicates encrypt side.
		if (gcm1000Encrypt_f) {
			showActiveEncOBF1000();
		}
	});
	// AES-CTR
	document.getElementById('aesctr_plaintext').addEventListener("focus", (event) => {
		activateEncAESCTR();
	});
	document.getElementById('aesctr_ciphertext').addEventListener("focus", (event) => {
