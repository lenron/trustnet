	async function executeTriple() {
		// Encrypt / Decrypt buttons set this flag which determines encrypt or decrypt function.
		if (tripleEncrypt_f === true) { // Encrypt function
			// Gather inputs.
			const cleartext = document.getElementById('triple_cleartext').value;
			const password1GCM = document.getElementById('triple_password_1').value;
			const password2CTR = document.getElementById('triple_password_2').value;
			const password3OpenSSL = document.getElementById('triple_password_3').value;
			// If both cleartext and password are empty, do nothing: want user to see blank slate till they enter something.
			try {
				document.getElementById('triple_ciphertext').value = await encryptTriple(password1GCM, password2CTR, password3OpenSSL, cleartext);
				document.getElementById('triple_outcome_message').style.visibility = 'visible';
				document.getElementById('triple_outcome_message').style.color = 'lime';
				document.getElementById('triple_outcome_message').innerHTML = 'SUCCESSFULLY ENCRYPTED';
			} catch (error) {
				console.log(error);
				document.getElementById('triple_outcome_message').style.visibility = 'visible';
				document.getElementById('triple_outcome_message').style.color = 'red';
				document.getElementById('triple_outcome_message').innerHTML = 'Error: Encryption unsuccessful';
				document.getElementById('triple_ciphertext').value = '';
			}
		} else { // Decrypt function
			// Gather inputs.
			const ciphertext = document.getElementById('triple_ciphertext').value;
			const password1GCM = document.getElementById('triple_password_1').value;
			const password2CTR = document.getElementById('triple_password_2').value;
			const password3OpenSSL = document.getElementById('triple_password_3').value;
			// Execute
			try {
				document.getElementById('triple_cleartext').value = await decryptTriple(password1GCM, password2CTR, password3OpenSSL, ciphertext);
				document.getElementById('triple_outcome_message').style.visibility = 'visible';
				document.getElementById('triple_outcome_message').style.color = 'lime';
				document.getElementById('triple_outcome_message').innerHTML = 'SUCCESSFULLY DECRYPTED';
			} catch (error) {
				console.log(error);
				document.getElementById('triple_outcome_message').style.visibility = 'visible';
				document.getElementById('triple_outcome_message').style.color = 'red';
				document.getElementById('triple_outcome_message').innerHTML = 'Decryption unsuccessful';
				document.getElementById('triple_cleartext').value = '';
			}
		}
		clearTimeout(timeoutIdTriple)
		timeoutIdTriple = setTimeout(() => {
			turnOffTripleDecryptOutcomeMessage();
		}, 2000); 
		// Show length AFTER execution.
		setLengthTriple();
	}// executeTriple()
	let timeoutIdTriple;

	function setLengthTriple() {
		// Cleartext 
		const cleartext = document.getElementById('triple_cleartext').value;
		const cleartextByteSize = new Blob([cleartext]).size;
		const cleartext_bytesize_string = "Bytes: " + cleartextByteSize;
		document.getElementById('triple_cleartext_bytesize_label').innerHTML = cleartext_bytesize_string;
		// Ciphertext
		const ciphertext = document.getElementById('triple_ciphertext').value;
		const ciphertextByteSize = new Blob([ciphertext]).size;
		const ciphertext_bytesize_string = "Bytes: " + ciphertextByteSize;
		document.getElementById('triple_ciphertext_bytesize_label').innerHTML = ciphertext_bytesize_string;
	}

