		// Show them again on save? Or go to store success/fail?
	}

	async function attemptCMDAccess() {
		goBackProgrammaticallyXandDontFireShowPage(3);
		const fingerprint = await computeFingerprint(offlineData['codeword'], offlineData['obf1000Pass'], offlineData['ctrPass']);
		// Add additional parameter?
		const multiEncryptedDatarecord = await attemptLoadOfflineDBase(fingerprint);

		if (multiEncryptedDatarecord === 'miss' || multiEncryptedDatarecord.length !== MULTI_ENCRYPTED_DATARECORD_LENGTH_BASE64 || !checkBase64Chars(multiEncryptedDatarecord)) {
			showPage('failed_to_access');
		}else{
			showPage('access_file');
			// On successful Access, hold fingerprint in HTML in case user wants to delete their data.
			decryptAndDownloadFileOffline(multiEncryptedDatarecord);
		}
	}

	async function attemptSyncToOnline(inputId) {
		goBackProgrammaticallyXandDontFireShowPage(2);
		// Get ctrPass - pass2.
		extractInputData(inputId);
		// First load encrypted data from offline database.
		const fingerprint = await computeFingerprint(offlineData['codeword'], offlineData['obf1000Pass'], offlineData['ctrPass']);
		const multiEncryptedDatarecord = await attemptLoadOfflineDBase(fingerprint);

		if (multiEncryptedDatarecord === 'miss' || multiEncryptedDatarecord.length !== MULTI_ENCRYPTED_DATARECORD_LENGTH_BASE64 || !checkBase64Chars(multiEncryptedDatarecord)) {
			showPage('failed_to_access'); // Access fail is valid here?
		}else{
			//showPage('access_file');
			// On successful Access, hold fingerprint in HTML in case user wants to delete their data.
			//decryptAndDownloadFileOffline(multiEncryptedDatarecord);
			//syncEncDataToServer(multiEncryptedDatarecord);
			storeDataToServer(fingerprint, multiEncryptedDatarecord);
		}
	}

	// Return either pass or fail to show outcome of store, pass or fail to user.
	// Legacy code probably needs full rewrite.
	async function storeDataToServer(fingerprint, multiEncryptedDatarecord) {
		// Attempt to store a record to the server.
		const storeResponse = await serverStore(fingerprint, multiEncryptedDatarecord);
		console.log("syncing data to server: storeResponse: " + storeResponse);
		if (storeResponse === 'STORES_OVER_100') {
			showPage('stores_over_100');
		}else{
			// Load data at fingerprint, should be the encrypted data block we just stored.
			const loadResponse = await serverLoad(fingerprint);
			console.log("syncing data to server: loadResponse: " + loadResponse);
			// Report store outcome.
			if (multiEncryptedDatarecord === loadResponse) {
				// We succeeded.
				showPage('sync_success');
			}else{
				// Doesn't look like server stored data properly, report fail.
				showPage('sync_failed');
			}
		}
	}// syncDataToServer()


	async function decryptAndDownloadFileOffline(multiEncryptedDatarecord) {
		const decryptedData  = await decryptDouble(offlineData['obf1000Pass'], offlineData['ctrPass'], multiEncryptedDatarecord);
			// bytes is Uint8Array
			const bytes = Uint8Array.fromBase64(decryptedData);
			// Produce file for user to decrypt.
			let blob = new Blob([bytes]);
			let a = document.createElement('a');
			a.href = window.URL.createObjectURL(blob);
			a.download = 'yourfile.enc';
			a.click();
	}// decryptAndDownloadFileOffline()

	async function attemptBrowserAccess(inputId) {
		goBackProgrammaticallyXandDontFireShowPage(4);
		// Encrypt and save OpenSSL password to passlockedData object.
		extractInputData(inputId);
		const fingerprint = await computeFingerprint(offlineData['codeword'], offlineData['obf1000Pass'], offlineData['ctrPass']);
		//console.log("fingerprint:" + fingerprint + " offlineData[codeword]:" + offlineData['codeword'] + " offlineData[obf1000Pass]:" + offlineData['obf1000Pass'] + " offlineData[ctrPass]:" + offlineData['ctrPass']);
		// First attempt loading from offline dbase. Can return 'miss'.
		const multiEncryptedDatarecord = await attemptLoadOfflineDBase(fingerprint);
		// Report outcome of Access attempt.
		if (multiEncryptedDatarecord === 'miss' || multiEncryptedDatarecord.length !== MULTI_ENCRYPTED_DATARECORD_LENGTH_BASE64 || !checkBase64Chars(multiEncryptedDatarecord)) {
			showPage('failed_to_access');
		}else{
			showPage('access_plaintext');
			await decryptAndShowPlaintextOffline(multiEncryptedDatarecord);
		}
	}

	async function decryptAndShowPlaintextOffline(multiEncryptedDatarecord) {
		let decryptedData;
		try {
			decryptedData  = await decryptTriple(offlineData['obf1000Pass'], offlineData['ctrPass'], offlineData['opensslpass'], multiEncryptedDatarecord);
		}catch (error) {
			// Would it make sense to catch a specific error?
			// Assume there was a password entry error.
			showPage("password_entry_error");
		}
		// Reveal plaintext to user.
		document.getElementById("access_data_outputdisplay").value = decryptedData;
	}

	async function attemptDelete() {
		const fingerprint = await computeFingerprint(offlineData['codeword'], offlineData['obf1000Pass'], offlineData['ctrPass']);
		const deleteResponse = await deleteRecordOfflineDBase(fingerprint);
		// Report delete outcome.
		if (deleteResponse === "success") {
			// Server successfully deleted data, report success.
			showPage('delete_success');
			setSaveToDiskReminder();
		}else{
			// Doesn't look like data was deleted properly, report fail.
			showPage('delete_failed');
		}
	}//attemptDelete()


	function clearSaveToDiskReminder() {
		document.getElementById("savetodisk_warning").style.display = "none";
	}

	function setSaveToDiskReminder() {
		document.getElementById("savetodisk_warning").style.display = "flex";
	}

	// Gonna need this functionality in order to store to disk.
	//
	// Grab currently running HTML and save it to standalone.html
	// This saves the offline dbase in addition to creating and downloading a standalone version that can be used offline.
	function saveToDisk() {
		// Clear reminder flag first or it will be active in saved file.
		clearSaveToDiskReminder();

		// This line doesn't get applied with the innerHTML call below so add it manually.
		let allhtml = "<!DOCTYPE HTML>";
		// This will grab a copy of the currently running HTML.
		allhtml += document.querySelector("html").innerHTML;
		//console.log(allhtml);
		let element = document.createElement('a');
		element.setAttribute('href', 'data:text/plain;charset=utf-8,' + encodeURIComponent(allhtml));
		element.setAttribute('download', 'standalone.html');
		element.style.display = 'none';
		document.body.appendChild(element);
		element.click();
		document.body.removeChild(element);
	}

	////////////////////////////////////////////////////////////////////////
	//                   Check Functions                                  //
	////////////////////////////////////////////////////////////////////////

	// Returns true if input has precisely FINGERPRINT_LENGTH_BASE64 (43) base64 chars.
	function checkFingerprintIsValid(fingerprint) {
		// Need backticks to wrap regex inside constructor call so that global constant variable FINGERPRINT_LENGTH_BASE64 can be passed in.
		const regex = new RegExp(\`^[A-Za-z0-9+/=]{\${FINGERPRINT_LENGTH_BASE64}}$\`); // !@#
		if (regex.test(fingerprint)) {
			return true;
		}else{
			return false;
		}
	}

	// Returns true if input has precisely MULTI_ENCRYPTED_DATARECORD_LENGTH_BASE64 (1024) base64 chars.
	function checkDataIsValid(data) {
		const regex = new RegExp(\`^[A-Za-z0-9+/=]{\${MULTI_ENCRYPTED_DATARECORD_LENGTH_BASE64}}$\`); // !@#
		if (regex.test(data)) {
			return true;
		}else{
			return false;
		}
	}

	// Input: input is a string.
	// Output: Returns false if non-base58 characters are detected.
	function checkBase64Chars(input) {
		// From the first char(^) to the last($), match base64 chars.
		const regex = new RegExp(/^[a-zA-Z0-9+=\/]*$/);
		if (regex.test(input)) {
			// Return true/valid
			return true;
		}else{
			// Return false/invalid
			return false;
		}
	}//checkBase64Chars()


</script>
