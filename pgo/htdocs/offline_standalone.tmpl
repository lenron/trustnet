<!DOCTYPE HTML>
<html>
<meta content="text/plain;charset=utf-8" http-equiv="Content-Type" />
<meta content="utf-8" http-equiv="encoding" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<head>
<!-- Import Orbitron font from google. -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&display=swap" rel="stylesheet">
</head>
<!---------------------CSS STYLE Section - Where CSS code which modifies how HTML code looks lives.-------------------------------------------------------------------!>
<style>

	/* OFFLINE DATABASE */

	/* There are 3 versions of the site, Online/Readonly and Offline which are maintained in two different code sets: index.tmpl (Online/Readonly) and offline_standalone.tmpl. */

	/* The Online/Readonly versions differ in two ways:
	/*   - Each use a different base color (Online Green: #54c597 and Readonly Blue: #4491d5)
	/*   - Store operations are removed from Readonly. */

	/* The Offline version works as one standalone file that fully runs in a browser, hiding data in a block of random text that lives in an HTML DOM object and thus needs no internet connection.
	/* The Offline site which holds the Offline Database can be generated from either the Online or Readonly versions of the site.
	/* Code for the Offline site, standalone.html, is stored in a heredoc which is located in function downloadStandalone() at the end of this file. */

	/* Perl HTML::Templates are used to manage generation and deployment of each of the site versions. TMPL_VAR values are injected from perl and
	/* generally differentiate Online and Readonly site versions. TMPL_INCLUDE values don't change and serve to import code that is re-used while
	/* helping to manage the codebase as well as allowing syntax highlighting to work in those included .tmpl files.
	/* The Offline Database standalone.html code is generated from a file nearly identical to this one called offline_standalone.tmpl
	/* which is kept similar in order to preserve readable structure. */

	/* We use a perl module HTML::Template which helps with code reuse / readability / maintainability. */
	/* TMPL_VAR values are injected from the perl script while TMPL_INCLUDE inserts all the code in a separate file at the location in this file */

	/* Set CSS color variable depending on which site this is. So down in the heredoc this will be set to red for the offline database and readonly will be chosen from perl. */
	/* Currently needed to do it this way so that offline database will be red no matter which site type generated it: online or readonly. */
	:root {
		--site-type-color: red;
		--hide-readonly-store-buttons: <TMPL_VAR NAME=hide_readonly_store_buttons>;
	}

	/* Insert CSS code common to main, readonly, and standalone.html offline database versions of the site. */
	<TMPL_INCLUDE NAME="common_css.tmpl">

</style><!---------------------------------------------END STYLE/CSS--------------------------------------------------------------------!>

<!-----------------------------------------------------HTML BODY - Where HTML code lives.------------------------------------------------------------------------------------!>
<body>
	<!-----------------------------------------------------MAIN PAGE------------------------------------------------------------------------------------!>
	<div class="main_page" id="main_page">
		<!-----------------------------------------------------SITE HEADER----------------------------------------------------------------------------------!>
		<div class="header" id="header">
			<div class="header_content" id="header_left">
				<div class="header_title">
					<a id="titletext" style="font-size:30px; text-decoration:underline;" >PGO-OFFLINEWORD</a>
				</div>
			</div>
			<div class="header_content" id="header_right">
				<div class="header_label" style="">
					<!-- Header links use javascript:void, instructing browser to not leave the current page. We handle navigation by changing visibility of HTML using showPage() and related functions. -->
					<a id="contact_link" href="javascript:void(0);" onclick="switchSite('faq_site')">FAQ</a>
				</div>
				<div class="header_label" style="">
					<a id="dev_site_link" href="javascript:void(0);" onclick="switchSite('dev_site')">DEV_SITE</a>
				</div>
				<div class="header_label" style="">
					<a id="contact_link" href="javascript:void(0);" onclick="switchSite('contact_page_captcha')">CONTACT</a>
				</div>
			</div>
		</div><!-----------------------------------------------------END SITE HEADER----------------------------------------------------------------------------------!>

		<!--------------------------SITEWIDE STATUS & WARNINGS---------------------------!>
		<!--------------------------Online Status---------------------------!>
		<div id="offline_status_div" style="display:flex; justify-content:space-between; margin:10px;">
			<label id="offline_label" style="" >YOU'RE OFFLINE. SERVER WILL NOT BE UPDATED WITH ANY NEW SAVES.</label>
		</div>
		<!--------------------------STALE FLOW WARNING---------------------------!>
		<div id="stale_flow_div" style="display:none; justify-content:space-between; margin:10px;">
			<label id="stale_flow_label" style="" >STALE FLOW! BACKING INTO A FLOW CAN CAUSE ISSUE! PLEASE START AT HOME.</label>
		</div>
		<!--------------------------STOP NAV WARNING---------------------------!>
		<div id="stop_nav_div" style="display:none; justify-content:space-between; margin:10px; ">
			<label id="stop_nav_label" style="color:red; " >NAVIGATION HALTED!<br>Backing from Browser Access flow end page is diallowed in order to preserve Edit functionality.</label>
		</div>
		<!--------------------------Offline Database Warning----------------------------!>
		<div id="full_offline_dbase_warning_div" style="display:flex; justify-content:space-between;">
			<label id="full_offline_dbase_warning" style="display:none; color:red;" >YOUR OFFLINE DATABASE IS FULL. ADDITIONAL STORES WILL NOT BE SAVED TO IT. IF ADDITIONAL STORAGE IS NEEDED, PLEASE INITIALIZE A NEW OFFLINE DATABASE (AFTER PROPERLY STORING THIS ONE).</label>
		</div>
		<!--------------------------END SITEWIDE STATUS & WARNINGS---------------------------!>

		<!--------------------------Div Housing for Flow Pages----------------------------!>
		<!-- Holds all show_page_activatable divs which function as 'pages' the user can navigate to. These divs are centered on the page. -->
		<div class="center_html" id="center_html" style="">
			<!-- FAQ, Dev Site page navigation is handled with showPage. We include it here in 'off' state, ready for user to click header link. -->
			<!--------------------------DEV SITE----------------------------!>
			<TMPL_INCLUDE NAME="dev_site_html.tmpl">
			<!--------------------------FAQ SITE----------------------------!>
			<TMPL_INCLUDE NAME="faq_html.tmpl">
			<!-- HTML for both main/readonly and offline included here. -->
			<TMPL_INCLUDE NAME="common_html.tmpl">
		</div><!--------------------------------------------END Center HTML----------------------------------------------------!>
		<!--------------------------------------------SITE FOOTER----------------------------------------------------!>
		<div style="display:flex; flex-direction:column;">
			<div id="savetodisk_warning" style="background-color:gray; display:none; flex-direction:column;">
				<h2>NEW DATA HAS BEEN STORED TO MEMORY. IN ORDER TO SAVE TO DISK PLEASE CLICK THIS BUTTON TO SAVE CURRENTLY RUNNING HTML TO A FILE. THIS WILL ALLOW YOUR DATA TO PERSIST THROUGH REBOOTS.</h2>
				<button id='' style="align-self:center;" onclick="saveToDisk(); saveThenShowPage('offline_home')">SAVE DATA TO DISK</button>
			</div>
		</div><!--------------------------------------------END SITE FOOTER----------------------------------------------------!>
	</div><!--------------------------------------------END MAIN PAGE----------------------------------------------------!>
</body><!--------------------------------------------END HTML BODY----------------------------------------------------!>
<script>

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	//              OFFLINE DATABASE SITE                                                                                                   //
	//                                                                                                                                      //
	// Common code that is used by all site versions reside in TMPL_INCLUDE files.                                                          //
	// Code that must be different lives in either index.tmpl or offline_standalone.tmpl (this file).                                       // 
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


	//////////////////////////////////////////////////////////////
	//                The Onload Function                       //
	//////////////////////////////////////////////////////////////
	// This event is fired after page elements have loaded.
	window.onload = async function() {
		// Initial server online check.
		updateOnlineStatus();
		// Set up all copy to click listeners.
		addListenersToAllCopyToClick();
		// Don't start flow unless everything seems to have loaded properly. All pages start with style.display = none for security.
		showPage('enter_offlinedbase_pass'); // Use a direct showPage() to NOT create a historical record.
	}// window.onload

	//////////////////////////////////////////////////////////////
	//             Included Template Files                      //
	//////////////////////////////////////////////////////////////
	// Javascript functions that are common to both main site index.html as well as offline database standalone.html.
	<TMPL_INCLUDE NAME="common_js.tmpl">
	// Javascript native subtleCrypto lib based library used for Multi Encrypted Datarecord (MEDrecord) encryption/decryption.
	<TMPL_INCLUDE NAME="core_crypto.tmpl">
	// Dev site javascript functions. Handles UI & crypto wrapper functions.
	<TMPL_INCLUDE NAME="dev_site_js.tmpl">
	// Fetch based server communication functions that interact with an online server.
	// - Might merge with common
	// - Need to devise wise way to use an if to filter out server comms functions that we wish to prune for security and otherwise.
	<TMPL_INCLUDE NAME="server_comms.tmpl">

	//////////////////////////////////////////////////////////////
	//             Site Specific Variables                      //
	//////////////////////////////////////////////////////////////
	// These variables allow switching to offline database variable value in offline_standalone.tmpl code set while preserving main/readonly site differences.
	const siteColor = 'red';

	//////////////////////////////////////////////////////////////
	//             Site Specific Function Switches              //
	//////////////////////////////////////////////////////////////
	// Wrappers that allow a single function to be called that has differing function between main and offlinse site versions. //
	//
	// Offline database is different - starts with offline database password entry (access either enc or unenc database).
	function goHome() {
		switchSite("enter_offlinedbase_pass");
	}// goHome()
	// Function call wrapper that allows online and offline use of catchUpload.
	async function saveFileData(filedata) {
		offlineData['data'] = filedata;
	}// saveFileData()
	// Clear data when user leaves Edit page.
	function resetData() {
		resetOfflineData();
	}// resetData()

	///////////////////////////////////////////////////////////////////////
	///////////////////////////////////////////////////////////////////////
	//                 Offline Database Manipulation                     //
	///////////////////////////////////////////////////////////////////////
	///////////////////////////////////////////////////////////////////////

	// Replaces the randomly generated 'dummy' chars with 43 length fingerprint and 1024 length encrypted data.
	// Used for store when fingerprint does not exist. Pointer needed for this function. 
	function storeFingerprintAndDataToOfflineDBase(pointer, fingerprint, multiEncryptedDatarecord, offlineDatabase) {
		// Multiplying moves us to record at pointer.
		const recordStart = pointer * FINGERPRINT_AND_MEDRECORD_LENGTH_BASE64;
		const recordEnd = recordStart + FINGERPRINT_AND_MEDRECORD_LENGTH_BASE64;
		// Compile replacement database. 
		// <Data in database until recordStart> + <fingerprint data> + <MED data> + <Data in database until recordEnd>
		return offlineDatabase.substring(0, recordStart) + fingerprint + multiEncryptedDatarecord + offlineDatabase.substring(recordEnd);
	}// storeFingerprintAndDataToOfflineDBase()

	// Used for delete, RandDAta is needed to backfill keeping offlineDatabase the same length.
	// Used for store when fingerprint exists.
	function replaceFingerprintAndData(fingerprint, offlineDatabase, newData='delete') {
		const fingerprintStartIndex = offlineDatabase.indexOf(fingerprint);
		// Use a random fingerprint and data if neither were specified.
		if (newData === 'delete') {
			fingerprint = getRandFingerprint();
			newData = getRandMultiEncryptedDatarecord();
		}
		const recordEnd = fingerprintStartIndex + FINGERPRINT_AND_MEDRECORD_LENGTH_BASE64;
		return offlineDatabase.substring(0, fingerprintStartIndex) + fingerprint + newData + offlineDatabase.substring(recordEnd);
	}// replaceFingerprintAndData()

	// Selects either Unencrypted or Encrypted database pointer based on if user inputted an offline database password at the start of the Flow.
	async function getOfflineDBasePointer() {
		// To determine which database pointer to return, first check if user entered an Offline Database password.
		if (getOfflineDatabaseType() === 'unencrypted') {
			return document.getElementById("offline_dbase_pointer").innerHTML;
		}else{
			const encPointer = document.getElementById("offline_dbase_enc_pointer").innerHTML;
			return await decryptTriple(offlineData['offlineDBasePass'], offlineData['offlineDBasePass'], offlineData['offlineDBasePass'], encPointer);
		}
	}// getOfflineDBasePointer()

	// Returns either Unencrypted or Encrypted full offline database depending if user entered an offline database password.
	async function getOfflineDBase() {
		// To determine which database pointer to return, first check if user entered an Offline Database password.
		if (getOfflineDatabaseType() === 'unencrypted') {
			// User didn't enter password, return unencrypted as-is.
			return document.getElementById("offline_dbase").innerHTML;
		}else{
			// We need to decrypt the encrypted offline database which is stored in the html element.
			const encOfflineDatabase = document.getElementById("offline_dbase_enc").innerHTML;
			return await decryptAESCTR(encOfflineDatabase, offlineData['offlineDBasePass']);
		}
	}// getOfflineDBase()

	// Saves pointer to memory-stored HTML.
	async function setOfflineDBasePointer(pointer) {
		// To determine which database pointer to return, first check if user entered an Offline Database password.
		if (getOfflineDatabaseType() === 'unencrypted') {
			document.getElementById("offline_dbase_pointer").innerHTML = pointer;
		}else{
			document.getElementById("offline_dbase_enc_pointer").innerHTML = await encryptTriple(offlineData['offlineDBasePass'], offlineData['offlineDBasePass'], offlineData['offlineDBasePass'], pointer);
		}
	}// setOfflineDBasePointer()

	// Saves full database to its home in html memory.
	async function setOfflineDBase(dbase) {
		// To determine which database pointer to return, first check if user entered an Offline Database password.
		if (getOfflineDatabaseType() === 'unencrypted') {
			document.getElementById("offline_dbase").innerHTML = dbase;
		}else{
			document.getElementById("offline_dbase_enc").innerHTML = await encryptAESCTR(dbase, offlineData['offlineDBasePass']);
		}
	}// setOfflineDBase()

	// Check that fingerprint is the correct length and is composed of only base64 characters.
	function validateFingerprintAndData(fingerprint, multiEncryptedDatarecord) {
		if (!validateFingerprint(fingerprint)) {
			throw new Error('Attempt to store to offline dbase failed! FINGERPRINT is invalid.');
		}else{
			console.log("FINGERPRINT IS VALID!");
		}

		if (!validateData(multiEncryptedDatarecord)) {
			throw new Error('Attempt to store to offline dbase failed! DATA is invalid.');
		}else{
			console.log("DATA IS VALID!");
		}
	}// validateFingerprintAndData()

	// Determine which database (encrypted or uncrypted) we're currently using.
	function getOfflineDatabaseType() {
		// To determine which database pointer to return, first check if user entered an Offline Database password.
		if (offlineData['offlineDBasePass'] === undefined) {
			return "unencrypted";
		}else{
			return "encrypted";
		}
	}// getOfflineDatabaseType()

	// If pointer is over 999 return false.
	function checkIfOfflineDBaseIsFull(pointer) {
		// Check if offline database is full.
		if (pointer > MAX_POINTER_VALUE) {//999 is ok because we should still be able to store to the last location in the 1000 record databaase. 
			// Inform user offline database is full.
			document.getElementById("full_offline_dbase_warning").style.display = "inline";
			return true;
		}else{
			document.getElementById("full_offline_dbase_warning").style.display = "none";
			return false;
		}
	}// checkIfOfflineDBaseIsFull()

	// -1 will indicate that the fingerprint was not found.
	function fingerprintExists(fingerprint, offlineDatabase) {
		if (offlineDatabase.indexOf(fingerprint) >= 0) {
			return true;
		}else{
			return false;
		}
	}// fingerprintExists()

	// Store single record to the offline database selected by if user enters offline database password or not.
	async function storeOfflineDBase(fingerprint, multiEncryptedDatarecord) {
		// Reject invalid data.
		validateFingerprintAndData(fingerprint, multiEncryptedDatarecord);
		// Retrieve the database and pointer for the Flow we are in.
		let pointer = await getOfflineDBasePointer();
		//console.log("pointer value: " + pointer);
		let offlineDatabase = await getOfflineDBase();
		//Check if the offline database is full.
		if (checkIfOfflineDBaseIsFull(pointer)) {
			return "full";
		}
		// Variable to hold the new database.
		let replacement_offlineDatabase;
		//Check if the fingerprint matches the database and replace the data.
		if (fingerprintExists(fingerprint, offlineDatabase)) {
			replacement_offlineDatabase = replaceFingerprintAndData(fingerprint, offlineDatabase, multiEncryptedDatarecord);
		}else{ // If the fingerprint was not found, store a new value in the database.
			replacement_offlineDatabase = storeFingerprintAndDataToOfflineDBase(pointer, fingerprint, multiEncryptedDatarecord, offlineDatabase);
			pointer++;
			checkIfOfflineDBaseIsFull(pointer);
		}
		// Save pointer and offline database to in-memory HTML. ENC or UNENC determined by if an offline database ENC password was entered at flow start.
		await setOfflineDBasePointer(pointer);
		await setOfflineDBase(replacement_offlineDatabase);
	}// storeOfflineDBase()

	// Try to load record at fingerprint. Works on both ENC and UNENC offline databases.
	async function attemptLoadOfflineDBase(fingerprint) {
		//console.log("Attempting Load. fingerprint: " + fingerprint);
		let offlineDatabase = await getOfflineDBase();
		// Search for fingerprint in offline dbase using regex.
		// fingerprintStartIndex will be the index of the beginning of the matched fingerprint.
		if (fingerprintExists(fingerprint, offlineDatabase)) {
			return getRecordOfflineDBase(fingerprint, offlineDatabase);
		}else{
			// Did  not find data on load attempt.
			return "miss";
		}
	}//attemptLoadOfflineDBase(()

	// Retrieve one 1000-char data record from an offline database. 
	function getRecordOfflineDBase(fingerprint, offlineDatabase) {
		const fingerprintStartIndex = offlineDatabase.indexOf(fingerprint);
		const fingerprintEndIndex = fingerprintStartIndex + FINGERPRINT_LENGTH_BASE64;
		const dataEndIndex = fingerprintEndIndex + MULTI_ENCRYPTED_DATARECORD_LENGTH_BASE64;
		// Get the data between fingerprintEndIndex and dataEndIndex.
		return offlineDatabase.substring(fingerprintEndIndex, dataEndIndex);
	}// getRecordOfflineDBase()

	// Check fingerprint validity for deleteRecordOfflineDBase()
	function validateFingerprint(fingerprint) {
		if (!validateFingerprint(fingerprint)) {
			throw new Error('Attempt to DELETE single record in offline dbase failed! FINGERPRINT is invalid.');
		}else{
			console.log("Delete Offline Database record attempt: FINGERPRINT IS VALID!");
		}
	}// validateFingerprint()

	// Random data is generated and 'backfilled' increasing security and keeping Offline Database length the same.
	async function deleteRecordOfflineDBase(fingerprint) {
		validateFingerprint(fingerprint);
		// Select either ENC or UNENC pointer, offline database depending on if user entered ENC passowrd.
		let offlineDatabase = await getOfflineDBase();
		// Find record in offline dbase if it exists.
		// If the record exists, delete the fingerprint and data at fingerprintStartIndex location by overwriting with randonly generated, decrementing pointer.
		if (fingerprintExists(fingerprint, offlineDatabase)) {
			// Calling with empty third parameter indicates to replace with random data (deleting the record).
			const replacement_offlineDatabase = replaceFingerprintAndData(fingerprint, offlineDatabase);

			await setOfflineDBase(replacement_offlineDatabase);
			// Check that it was in fact deleted. Fingerprint should be random chars now and therefore miss on a correctly exexuted delete.
			const outcome = await attemptLoadOfflineDBase(fingerprint);
			if (outcome === "miss") {
				//console.log("Delete successful: returned miss from load attempt.");
				return "success";
			}else{
				console.log("Failed to delete data from offline database.");
				return "failed";
			}
		}else{
			console.log("Failed to find fingerprint, data to delete.");
			return "failed";
		}
	}//deleteRecordOfflineDBase()


	//////////////////////////////////////////////////////////////
	//////////////////////////////////////////////////////////////
	//         OFFLINE FLOWWALKER FUNCTIONALITY                 //
	//////////////////////////////////////////////////////////////
	//////////////////////////////////////////////////////////////
	// Since the offline site is meant to be used in a secure environment with no access to a server (where passlocks are stored) the passlock system is not used for the offline database.

	// Reset user-data storage object, clearing passwords and data.
	function resetOfflineData() {
		offlineData = {};
	}// resetOfflineData()

	// Extract encrypted offline database password from HTML.
	async function extractOfflineDatabasePassword() {
		// This is the start of the offline flow. Clear any existing data.
		resetOfflineData();
		// Extract encrypted offline database password from input field.
		extractInputData('set_offlineDBasePass_input');
		// Verify password matches the one used to encrypt this offline database.
		await verifyOfflineDatabasePassword();
	}// extractOfflineDatabasePassword()

	// Verify that entered password matches the one used to encrypt this offline database.
	async function verifyOfflineDatabasePassword() {
		// Catch an empty password (e.g. user hit enter accidentally).
		if (offlineData['offlineDBasePass'] === undefined || offlineData['offlineDBasePass'] === '') {
			console.log('caught empty ENC password');
			// Show empty password warning in UI.
			document.getElementById('emptyPassWarning').style.display = 'inline';
		}else{
			console.log('ENC password has successfully been entered.');
			const encPassCorrect = await validateEncPassword();
			if (encPassCorrect) {
				// returned true, Enc password correct.
				showPage('offline_home');
			}else{
				// returned false, Enc password incorrect.
				showPage('wrong_offlinedbase_password');
			}
		}
	}// verifyOfflineDatabasePassword()

	// Try to decrypt pointer in order to check if Enc password is correct.
	async function validateEncPassword() {
		try{
			// Attempt to decrypt pointer.
			await getOfflineDBasePointer();
		}catch (error) {
			console.log("Looks like enc password entered incorrectly. error: ");
			console.log(error);
			return false;
		}
		return true;
	}// validateEncPassword()

	// Input ids that hold passwords to be extracted are constructed in a regular way so their data can be uniformly accessed.
	// Example for ctrPass: access_ctrPass_input
	// Looking at the above Element ID, we can see that this input will hold the ctrPass (AES-CTR password) and resides in the Access Flow.
	function extractKeyword(inputId) {
		// Use regex to extract keyword from input ID.
		const regex = new RegExp(/^\\w+_(\\w+)_\\w+$/);
		const match = inputId.match(regex);
		// Return the middle word, which is held in the 'match' array at index 1.
		return match[1];
	}// extractKeyword()

/*
	// Extract user data from HTML and then delete it from HTML source for security.
	function extractPlaintextData(inputId) {
		// Copy data from HTML to js variable.
		const plaintextData = document.getElementById(inputId).value;
		// Delete data from HTML input field.
		document.getElementById(inputId).value = "";
		return plaintextData;
	}// extractPlaintextData()
*/

	// Wrapper for extractInputData needed for offline site in order to keep HTML uniform across all 3 sites.
	async function initFlow(inputId) {
		// Would have used this function call directly in HTML but then would need different HTML page for main/readonly and offline site versions.
		extractInputData(inputId);
	}// initFlow()

	// Different storage object than main used because offline site lacks passlock system.
	let offlineData = {};
	// Extract plaintext data from HTML object, then store it in offline storage object, readying for computation later.
	function extractInputData(inputId) {
		// Use regex to extract keyword from input ID.
		const keyword = extractKeyword(inputId);
		// Make sure user data is being gathered in order. Any out of order execution will result in error for security.
		if (keyword !== 'offlineDBasePass' && keyword !== 'codeword' && offlineData['codeword'] === undefined) {
			saveThenShowPage('timed_out_home');
			throw new Error("STALE FLOW ERROR.");
		}
		console.log("Extracting keyword: " + keyword);
		// Extract user data from HTML and then delete it from HTML source for security.
		const plaintextData = extractPlaintextData(inputId);
		// Save data to storage object for computation later.
		offlineData[keyword] = plaintextData;
		console.log("Password gathering object: offlineData: ");
		console.log(offlineData);
	}// extractInputData()

	// Re-iteration check: validate that the password entered on the re-iteration step matches the original entry.
	function validateInputData(inputId, nextPageId) {
		saveCurrentStateToHistorySoBackWillWork();
		// Get password entered on this re-iteration step.
		const keyword = extractKeyword(inputId);
		const plaintextPass = extractPlaintextData(inputId);
		// Check that it matches the password entered in the original step.
		if (offlineData[keyword] === plaintextPass) {
			// Password re-iterated successfully, continue to next page.
			showPage(nextPageId);
		}else{
			// Re-iterated password doesn't match original.
			showPassCheckFailWarnings();
			throw new Error("Offline Passwords are different!");
			// Failed to re-iterate, Stay on this page.
		}
	}// validateInputData()

	// Attempt to store a command line encrypted file.
	// Check fingerprint & data are valid then send to storeDataToServer which handles errors and displays the outcome to user.
	// This offline function also handles showing errors and reminder to save to disk.
	async function attemptCMDStore() {
		// Use gathered passwords to compute a fingerprint.
		const fingerprint = await computeFingerprint(offlineData['codeword'], offlineData['obf1000Pass'], offlineData['ctrPass']);
		// Encrypt user data with user passwords.
		const multiEncryptedDatarecord = await encryptDouble(offlineData['obf1000Pass'], offlineData['ctrPass'], offlineData['data']);
		// Store MEDRecord to fingerprint location inside offline database HTML object.
		let storeResponse = await storeOfflineDBase(fingerprint, multiEncryptedDatarecord);

		// Check that data stored properly.
		// Load data at fingerprint, should be the encrypted data MEDRecord we just stored.
		const loadResponse = await attemptLoadOfflineDBase(fingerprint);
		// Report store outcome.
		if (multiEncryptedDatarecord === loadResponse) {
			// Data successfully stored to memory. Still needs saved to disk which must happen manually by user.
			setSaveToDiskReminder();
			showPage('store_success');
		}else{
			// Doesn't look like server stored data properly, report fail.
			showPage('store_failed');
		}
		// Always reset plaintext data holder each time flow is completed.
		resetOfflineData();
	}// attemptCMDStore()

	// Attempt to store data from Browser.
	// Check fingerprint & data are valid then send to storeDataToServer which handles errors and displays the outcome to user.
	async function attemptBrowserStore(inputId) {
		extractInputData(inputId);
		// Use gathered passwords to compute a fingerprint.
		const fingerprint = await computeFingerprint(offlineData['codeword'], offlineData['obf1000Pass'], offlineData['ctrPass']);
		// Encrypt user data with user passwords.
		const multiEncryptedDatarecord = await encryptTriple(offlineData['obf1000Pass'], offlineData['ctrPass'], offlineData['opensslpass'], offlineData['data']);
		// Store MEDRecord to fingerprint location inside offline database HTML object.
		let storeResponse = await storeOfflineDBase(fingerprint, multiEncryptedDatarecord);

		// Check that data stored properly.
		// Load data at fingerprint, should be the encrypted data block we just stored.
		const loadResponse = await attemptLoadOfflineDBase(fingerprint);
		// Report store outcome.
		if (multiEncryptedDatarecord === loadResponse) {
			showPage('store_success');
			setSaveToDiskReminder();
			// We succeeded.
			if (inputId === 'access_data_outputdisplay') {
				showPage('edit_success');
			}else{
				// Data successfully stored to memory. Still needs saved to disk which must happen manually by user.
				showPage('store_success');
			}
		}else{
			// Doesn't look like server stored data properly, report fail.
			showPage('store_failed');
		}
		// Always reset plaintext data holder each time flow is completed.
		resetOfflineData();
	}// attemptBrowserStore()

	// Modify the UI to allow the user to Edit data they have just Accessed (page at the end of the Access Flow).
	async function editData() {
		document.getElementById('access_data_outputdisplay').disabled = false;
		// Turn on textarea so user can edit.
		document.getElementById('access_data_outputdisplay').focus();
		showEditEnabledUI();
		// Hide both existing buttons
		document.getElementById("editdata_button").style.display = "none";
		document.getElementById("delete_button").style.display = "none";
		// Show single SAVE button
		document.getElementById("save_button").style.display = "inline";
		// Show them again on save? Or go to store success/fail?
	}// editData()

	// Attempt to access a MEDRecord at fingerprint location in the offline database, then display outcome to user (file download).
	async function attemptCMDAccess() {
		const fingerprint = await computeFingerprint(offlineData['codeword'], offlineData['obf1000Pass'], offlineData['ctrPass']);
		// Add additional parameter?
		const multiEncryptedDatarecord = await attemptLoadOfflineDBase(fingerprint);

		if (multiEncryptedDatarecord === 'miss' || multiEncryptedDatarecord.length !== MULTI_ENCRYPTED_DATARECORD_LENGTH_BASE64 || !validateBase64Chars(multiEncryptedDatarecord)) {
			resetOfflineData();
			showPage('failed_to_access');
		}else{
			showPage('access_file');
			// On successful Access, hold fingerprint in HTML in case user wants to delete their data.
			decryptAndDownloadFileOffline(multiEncryptedDatarecord);
		}
	}// attemptCMDAccess()

	// Attempt to store a MEDRecord from the offline database to the online server.
	async function attemptSyncToOnline(inputId) {
		// Get ctrPass - pass2.
		extractInputData(inputId);
		// First load encrypted data from offline database.
		const fingerprint = await computeFingerprint(offlineData['codeword'], offlineData['obf1000Pass'], offlineData['ctrPass']);
		const multiEncryptedDatarecord = await attemptLoadOfflineDBase(fingerprint);

		if (multiEncryptedDatarecord === 'miss' || multiEncryptedDatarecord.length !== MULTI_ENCRYPTED_DATARECORD_LENGTH_BASE64 || !validateBase64Chars(multiEncryptedDatarecord)) {
			showPage('failed_to_access'); // Access fail is valid here?
		}else{
			//showPage('access_file');
			// On successful Access, hold fingerprint in HTML in case user wants to delete their data.
			//decryptAndDownloadFileOffline(multiEncryptedDatarecord);
			//syncEncDataToServer(multiEncryptedDatarecord);
			storeDataToServer(fingerprint, multiEncryptedDatarecord);
		}
		// Replace goBack function with security reset and we should be secure right?
		// Always reset plaintext data holder each time flow is completed.
		resetOfflineData();
	}// attemptSyncToOnline()

	// Attempt to store data to online server. Show outcome in UI.
	async function storeDataToServer(fingerprint, multiEncryptedDatarecord) {
		// Attempt to store a record to the server.
		const storeResponse = await serverStore(fingerprint, multiEncryptedDatarecord);
		console.log("syncing data to server: storeResponse: " + storeResponse);
		if (storeResponse === 'STORES_OVER_100') {
			showPage('stores_over_100');
		}else{
			// Load data at fingerprint, should be the encrypted data block we just stored.
			const loadResponse = await serverLoad(fingerprint);
			console.log("syncing data to server: loadResponse: " + loadResponse);
			// Report store outcome.
			if (multiEncryptedDatarecord === loadResponse) {
				// We succeeded.
				showPage('sync_success');
			}else{
				// Doesn't look like server stored data properly, report fail.
				showPage('sync_failed');
			}
		}
	}// storeDataToServer()

	// Process an Accessed MEDRecord: decrypt it then pack the decrypted data into a file for user download.
	async function decryptAndDownloadFileOffline(multiEncryptedDatarecord) {
		const decryptedData  = await decryptDouble(offlineData['obf1000Pass'], offlineData['ctrPass'], multiEncryptedDatarecord);
			// bytes is Uint8Array
			const bytes = Uint8Array.fromBase64(decryptedData);
			// Produce file for user to decrypt.
			let blob = new Blob([bytes]);
			let a = document.createElement('a');
			a.href = window.URL.createObjectURL(blob);
			a.download = 'yourfile.enc';
			a.click();
	}// decryptAndDownloadFileOffline()

	// Attempt to access a MEDRecord at fingerprint location, then display outcome to user (Browser Access).
	async function attemptBrowserAccess(inputId) {
		// Encrypt and save OpenSSL password to passlockedData object.
		extractInputData(inputId);
		const fingerprint = await computeFingerprint(offlineData['codeword'], offlineData['obf1000Pass'], offlineData['ctrPass']);
		// First attempt loading from offline dbase. Can return 'miss'.
		const multiEncryptedDatarecord = await attemptLoadOfflineDBase(fingerprint);
		// Report outcome of Access attempt.
		if (multiEncryptedDatarecord === 'miss' || multiEncryptedDatarecord.length !== MULTI_ENCRYPTED_DATARECORD_LENGTH_BASE64 || !validateBase64Chars(multiEncryptedDatarecord)) {
			resetOfflineData();
			showPage('failed_to_access');
		}else{
			showPage('access_plaintext');
			// Activate flag so if user hits back button, we'll be able to catch it.
			activateStopNavFlag();
			startObserving();
			await decryptAndShowPlaintextOffline(multiEncryptedDatarecord);
		}
	}// attemptBrowserAccess()

	// Decrypt a MEDRecord that has been Accessed, show that plaintext to user via browser.
	async function decryptAndShowPlaintextOffline(multiEncryptedDatarecord) {
		let decryptedData;
		// Attempt decryption within a try-catch loop here since an incorrect password 3 will error and we would like to inform user of that instead of breaking flow.
		try {
			decryptedData  = await decryptTriple(offlineData['obf1000Pass'], offlineData['ctrPass'], offlineData['opensslpass'], multiEncryptedDatarecord);
		}catch (error) {
			// Looks like a password entry error.
			showPage("password_entry_error");
		}
		// Reveal plaintext to user.
		document.getElementById("access_data_outputdisplay").value = decryptedData;
	}// decryptAndShowPlaintextOffline()

	// Attempt to delete a record.
	// Compute a fingerprint using collected user passwords, then delete the data stored at that fingerprint.
	async function attemptDelete() {
		// Compute fingerprint from user passwords.
		const fingerprint = await computeFingerprint(offlineData['codeword'], offlineData['obf1000Pass'], offlineData['ctrPass']);
		// Attempt to delete MEDRecord at fingerprint location.
		const deleteResponse = await deleteRecordOfflineDBase(fingerprint);
		// Report delete outcome.
		if (deleteResponse === "success") {
			// Server successfully deleted data, report success.
			showPage('delete_success');
			setSaveToDiskReminder();
		}else{
			// Doesn't look like data was deleted properly, report fail.
			showPage('delete_failed');
		}
	}//attemptDelete()

	function clearSaveToDiskReminder() {
		document.getElementById("savetodisk_warning").style.display = "none";
	}// clearSaveToDiskReminder()

	function setSaveToDiskReminder() {
		document.getElementById("savetodisk_warning").style.display = "flex";
	}// setSaveToDiskReminder()

	// Create a standalone.html (offline database) version of the site (composed of the currently running HTML) and store it to the local disk.
	// This will contain data stored in the offline database (which is held in HTML variables).
	function saveToDisk() {
		// Clear nag flag first or it will be active in saved file.
		clearSaveToDiskReminder();
		// This line doesn't get applied with the innerHTML call below so add it manually.
		let allhtml = "<!DOCTYPE HTML>";
		// This will grab a copy of the currently running HTML.
		allhtml += document.querySelector("html").innerHTML;
		// Create placeholder element to be filled with HTML.
		let element = document.createElement('a');
		// Set the copy of running HTML to the placeholder element.
		element.setAttribute('href', 'data:text/plain;charset=utf-8,' + encodeURIComponent(allhtml));
		element.setAttribute('download', 'standalone.html');
		element.style.display = 'none';
		// Attach placeholder element to the running document so it can be manipulated.
		document.body.appendChild(element);
		// Click the invisible download button, downloading the just-created copy of standalone.html to the user's local disk.
		element.click();
		// Job's done, unlink the HTML copy from this document.
		document.body.removeChild(element);
	}// saveToDisk()

	////////////////////////////////////////////////////////////////////////
	//                   Check Functions                                  //
	////////////////////////////////////////////////////////////////////////

	// Returns true if input has precisely FINGERPRINT_LENGTH_BASE64 (43) base64 chars.
	function validateFingerprint(fingerprint) {
		// Need backticks to wrap regex inside constructor call so that global constant variable FINGERPRINT_LENGTH_BASE64 can be passed in.
		const regex = new RegExp(\`^[A-Za-z0-9+/=]{\${FINGERPRINT_LENGTH_BASE64}}$\`); // !@#
		if (regex.test(fingerprint)) {
			return true;
		}else{
			return false;
		}
	}// validateFingerprint()

	// Returns true if input has precisely MULTI_ENCRYPTED_DATARECORD_LENGTH_BASE64 (1024) base64 chars.
	function validateData(data) {
		const regex = new RegExp(\`^[A-Za-z0-9+/=]{\${MULTI_ENCRYPTED_DATARECORD_LENGTH_BASE64}}$\`); // !@#
		if (regex.test(data)) {
			return true;
		}else{
			return false;
		}
	}// validateData()

	// Input: input is a string.
	// Output: Returns false if non-base58 characters are detected.
	function validateBase64Chars(input) {
		// From the first char(^) to the last($), match base64 chars.
		const regex = new RegExp(/^[a-zA-Z0-9+=\/]*$/);
		if (regex.test(input)) {
			// Return true/valid
			return true;
		}else{
			// Return false/invalid
			return false;
		}
	}//validateBase64Chars()


</script>
