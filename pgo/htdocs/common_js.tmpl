	// Adds a copy to click listener to each HTML element that contains the respective class.
	function addListenersToAllCopyToClick() {
		// Add encrypt elements.
		let encryptElements = document.getElementsByClassName('encrypt_copy_to_click');
		for (let i = 0; i < encryptElements.length; i++) {
			encryptElements[i].addEventListener("click", () => copyEncryptOpenSslCmdToClipboard());
		}

		// Add decrypt elements.
		let decryptElements = document.getElementsByClassName('decrypt_copy_to_click');
		for (let i = 0; i < decryptElements.length; i++) {
			decryptElements[i].addEventListener("click", () => copyDecryptOpenSslCmdToClipboard());
		}
	}

	// Copy command line OpenSSL command to clipboard as user clicks div.
	async function copyEncryptOpenSslCmdToClipboard() {
		try {
			// Copy command to clipboard.
			await navigator.clipboard.writeText("openssl enc -aes-256-cbc -e -pbkdf2 -in yourfile.txt -out yourfile.enc");
			console.log("OpenSSL encrypt command copied to clipboard.");
			// Display message indicating command was copied to clipboard.
			showEncryptCommandCopied();
			// Undisplay message in 5 seconds after showing it.
			setTimeout(() => {
				hideEncryptCommandCopied();
			}, FIVE_SECONDS); 
		} catch (error) {
			console.error(error.message);
		}
	}

	// Copy command line OpenSSL command to clipboard as user clicks div.
	async function copyDecryptOpenSslCmdToClipboard() {
		try {
			// Copy command to clipboard.
			await navigator.clipboard.writeText("openssl enc -aes-256-cbc -d -pbkdf2 -in yourfile.enc -out yourfile.txt");
			console.log("OpenSSL decrypt command copied to clipboard.");
			// Display message indicating command was copied to clipboard.
			showDecryptCommandCopied();
			// Undisplay message in 5 seconds after showing it.
			setTimeout(() => {
				hideDecryptCommandCopied();
			}, FIVE_SECONDS); 
		} catch (error) {
			console.error(error.message);
		}
	}

