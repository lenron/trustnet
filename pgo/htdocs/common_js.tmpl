	// Reset state variables, etc. that could be security concern.
	function resetSecurityAndUI() {
		// Reset EDIT functionality buttons.
		document.getElementById("editdata_button").style.display = hideReadonlyButtons;
		document.getElementById("delete_button").style.display = hideReadonlyButtons;
		document.getElementById("save_button").style.display = "none";
		// Return Access Success page to default input disabled state.
		showEditDisabledUI();
		// Clear data input running byte total.
		document.getElementById("browserdata_length_label").innerHTML = '';
		document.getElementById("editdata_length_label").innerHTML = '';
		document.getElementById("uploaddata_length_label").innerHTML = '';
		// Clear Store Upload file input (clears data from previously uploaded file).
		document.getElementById('store_upload_input').value = null;
		// Hide Store Upload commit button shown upon user uploading a file.
		document.getElementById("store_upload_commit_button").style.display = "none";
		// Hide READY TO COMMIT message shown upon user uploading a file.
		document.getElementById("store_upload_readytocommit").style.display = "none";
		// Clear Accessed, decrypted user data.
		document.getElementById("access_data_outputdisplay").value = '';
		// Clear fingerprint held for delete.
		document.getElementById("fingerprint_holder").value = '';
		// Check if we're online and inform user if we are or not.
		updateOnlineStatus();
		// Hide password RE-Entry check warnings (passlock flow).
		hidePassCheckFailWarnings();
		// Reset delete overlay
		deleteCheckHide('overlay_delete_cmd');
		deleteCheckHide('overlay_delete_browser');
	}// resetSecurityAndUI()

