	////////////////////////////////////////////////////////////////////////////////////////////////////////////
	//							Browser Back functionality										     		  //
	////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Harnessing the browser's back functionality is complexity rooted in browser security decisions and the
	// functional opacity that brings. You are disallowed from things like deleting history records as a user moves
	// through a custom interface, so workarounds are needed. Because of the opacity of how this works in the browser,
	// testing and tuning was required to get it to work - there was no straightforward theory available.
	//
	// The goal is to map the back button to the last page of the UI a user was on.
	// This is achieved in 2 steps: creating a record in history for every page we want the user to be able to go back to.
	// And making sure that the proper page is returned to upon a user activating browser back function.
	//
	// Listen for the popstate event which is usually fired by user activating browser back button.
	// Once popstate is fired we navigate back to the page that was saved by the saveCurrentStateToHistorySoBackWillWork() function.
	window.addEventListener('popstate', (event) => {
		// Use event.state or window.location to update content
		if (showPageFlag === 'true') { // Don't show page flicker to user as flow job is completing.
			showPage(event.state.page);
		} else {
			// Skip showPage for this popstate:
			// we don't want to flicker as we're history.go()ing back programmatically if the user clicks back after completing a flow job.
			showPageFlag = 'true';
		}
	});

	// In order for custom back functionality to work, we have to manually save the page the user is navigating away from (which we want to be able to go back to) whenever they click/activate a button.
	function saveCurrentStateToHistorySoBackWillWork() {
		// Every time this function is called, we want that to be treated as a state that a back button click will go back to.
		const state = {page: currentPage}; // Create JS object with attribute page that has value currentPage.
		// First parameter for replaceState(), state is js object that can contain more data than just the page if needed.
		// Middle is a 'title' which is legacy per MDN. Third is URL of history entry (pretty much always gonna be obf.mkrsvr.org or equivalent).
		// Last, window.location should be url of current page.
		// Replace the current history entry with additional state data that we will use to return to with custom function.
		history.replaceState(state, '', window.location);
		// My current theory is under the hood function isn't expecting a manual removal of a state so we have to work around their garbage collection?
		// Create new (empty) entry in the history stack.
		// This function is needed for custom back to work even though we're not sure why exactly it's needed besides it breaking when this is removed.
		history.pushState({}, '', '');
	}// saveCurrentStateToHistorySoBackWillWork()

	// Create record in history whenever user moves to a new page. This enables history's back function to return to that page.
	// Used as a 'wrapper' solution to creating save states as the user moves through the UI.
	function saveThenShowPage(activateThisPage) {
		saveCurrentStateToHistorySoBackWillWork();
		showPage(activateThisPage);
	}// saveThenShowPage()

	// If true, activate showPage when popstate event fires. We set to false when we set the back 'pointer' programmatically.
	let showPageFlag = 'true';
	// For overall security and because the passlock system wasn't designed for users to browser back into it,
	// once a 'flow' completes, we move the history pointer so that if they do hit back, it will take them to the home page.
	// Browser security design disallow the removal of history records, which would be a cleaner solution than this function.
	// Programmers can add entries to history, but cannot remove them. This function is a workaround that needs to be tuned for each usage.
	function goBackProgrammaticallyXandDontFireShowPage(numPlaces) {
		// Don't flicker between multiple pages as the history pointer is programmatically moved to the home page.
		showPageFlag = 'false';
		// Move the pointer back a variable number of places. Each case of this number was found by trial and error.
		history.go(-numPlaces);
	}

	////////////////////////////////////////////////////////////////////////////////////////////////////////////
	//							          Show Page                                                           //
	////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Pages are defined by the 'flow_pages' class which is held by HTML div that holds DOM elements needed for that page's functionality.
	// Moving through the UI is accomplished by manipulating which 'page' is currently shown to the user;
	// the page to be made active is shown while all others are hidden. 
	// 
	// Global variable to keep track of the page we're on. Start on home page.
	let currentPage = 'home';
	// Hide all other pages, then show activateThisPage page. 
	// Input: Target is the element ID of a div containing class: flow_pages
	function showPage(activateThisPage) {
		// This global variable keeps track of the page the user is currently on. Needed for activatable-by-enter and harnessing browser back.
		currentPage = activateThisPage;
		// Reset UI warnings and clear all HTML input data as user moves through the interface.
		resetSecurityAndUI();
		// Fill flow_page_divs array with set of objects (divs) that contain the flow_pages class.
		//let flow_page_divs = document.getElementsByClassName('flow_pages');
		let flow_page_divs = document.getElementsByClassName('show_page_activatable');
		// Hide all of the flow pages.
		for (let i = 0; i < flow_page_divs.length; i++) {
			flow_page_divs[i].style.display = "none";
		}
		// Show the page -- make visible by changing display style from none to flex.
		document.getElementById(activateThisPage).style.display = "flex";
		// Focus input or textbox (for convenience).
		let inputs_array = document.getElementById(activateThisPage).getElementsByTagName('input');
		let textareas_array = document.getElementById(activateThisPage).getElementsByTagName('textarea');
		// There is only 1 input or 1 textarea per div in our setup.
		// If we found more than zero inputs in the array, focus the first and only one.
		if (inputs_array.length > 0) {
			inputs_array[0].focus();
		}else if (textareas_array.length > 0) {
			// Otherwise, we should find 1 textarea to focus if we need to focus anything.
			textareas_array[0].focus();
		}else{
			// If there's no input, focus the button with 'activatable_by_enter' class (used to select the 'default' option (BRWOSER) at UI branch.
			const buttonObj = document.getElementById(currentPage).querySelector('.activatable_by_enter');
			if (buttonObj !== null) {
				document.getElementById(buttonObj.id).focus();
			}
		}
	}// showPage()

	////////////////////////////////////////////////////////////////////////////////////////////////////////////
	//							activatable_by_enter functionality								     		  //
	////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// To empower the user to move through the interface quickly, we implement a class: activatable_by_enter.
	// The global variable currentPage holds the page currently in view of the user. When enter is clicked,
	// the following anonymous function will utilize querySelector to search for DOM objects containing the
	// activatable_by_enter class. The button containing this class will then be clicked.
	// 
	// In simple terms, users can hit enter while the input they're typing in is focused in order to move to the next page in the interface.
	// 
	// Globally detect when user hits ENTER on their keyboard.
	window.addEventListener("keydown", function(event) {
		if (event.key === "Enter") {
			// If focused element is an input, enter clicks the button containing the class: activatable_by_enter
			if (document.activeElement.tagName == "INPUT") {
				// Select all DOM objects containing the class: activatable_by_enter
				const buttonObj = document.getElementById(currentPage).querySelector('.activatable_by_enter');
				if (buttonObj !== null) {
					// Click button that was selected.
					buttonObj.click();
				}else{
					//console.log("Enter clicked but no activatable_by_enter class found: " + currentPage);
				}
				// https://stackoverflow.com/questions/50403457/focus-method-triggers-button-click-event
				// Prevent strange behavior where "the default action is performed on the newly focused element".
				event.preventDefault();
				// Without it the Branch screen was getting 'pre-clicked' when enter was pressed on previous Page.
			}else{
				// Focused element isn't an Input, do nothng I guess?
			}
		}
	});// activatable_by_enter page listener

