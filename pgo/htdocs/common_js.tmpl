	// Input: input is a string.
	// Output: Returns false if the input length (in bytes) is over OPENSSL_INPUT_LIMIT_BYTES: 686
	function checkDataInputLengthWithRegex(input) {
		// Get input size in bytes.
		let size = new Blob([input]).size;
		let difference = OPENSSL_INPUT_LIMIT_BYTES - size;
		// Show running count of data length.
		let size_string = "Byte length remaining: " + difference;
		document.getElementById("browserdata_length_label").innerHTML = size_string;
		document.getElementById("editdata_length_label").innerHTML = size_string;
		if (size > OPENSSL_INPUT_LIMIT_BYTES) {
			return false; // Length Check Failed.
		}else{
			return true; // Length Check Passed.
		}
	}// checkDataInputLengthWithRegex()

	// Input: input is a string.
	// Output: Returns false if the input length (in bytes) is over 544.
	function checkInputLengthUpload(input) {
		// show input size in bytes
		let size = new Blob([input]).size;
		let difference = OBF_1000_INPUT_LIMIT_BYTES - size;
		// Show running count of data length.
		let size_string = "Byte length remaining: " + difference;
		//console.log("size_string: " + size_string);
		document.getElementById("uploaddata_length_label").innerHTML = size_string;
		if (size > OBF_1000_INPUT_LIMIT_BYTES) {
			return false; // Length Check Failed.
		}else{
			return true; // Length Check Passed.
		}
	}// checkInputLengthUpload()

