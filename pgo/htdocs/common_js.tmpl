	// Replaces all upper case letters with lower case as user types them into the frontend UI.
	function codewordToLowerCase(events) {
		// .toLowerCase() needs a string to run.
		let userinput = '';
		// event.target.value returns the value of whichever input the user is currently typing in.
		userinput = event.target.value;
